ne":36},{"w":"can","s":169.89,"e":170.35,"line":36},{"w":"ring.","s":170.35,"e":171.11,"line":36},{"w":"I","s":171.11,"e":171.39,"line":37},{"w":"don't","s":171.39,"e":172.11,"line":37},{"w":"owe","s":172.11,"e":172.54,"line":37},{"w":"either","s":172.54,"e":173.4,"line":37},{"w":"one","s":173.4,"e":173.83,"line":37},{"w":"a","s":173.83,"e":174.12,"line":37},{"w":"thing.","s":174.12,"e":174.98,"line":37}],"lines":[{"s":1.2,"e":6.2,"text":"Three missed calls and a midnight clock,"},{"s":6.2,"e":10.44,"text":"I breathe in slow. I don't unlock."},{"s":10.44,"e":16.07,"text":"You said “right now,” tried to rush my reply,"},{"s":16.07,"e":22.94,"text":"Put a countdown on a question like the world would die."},{"s":22.94,"e":28.06,"text":"My hands felt cold, so I planted my feet,"},{"s":28.06,"e":33.43,"text":"Named five things I could see from my seat."},{"s":33.43,"e":38.8,"text":"A thought can knock; I don't have to agree."},{"s":38.8,"e":44.8,"text":"I can take my time deciding what's right for me."},{"s":44.8,"e":50.42,"text":"Let the phone ring out, let the silence stay,"},{"s":50.42,"e":55.3,"text":"No borrowed fear gets to choose my day."},{"s":55.3,"e":58.17,"text":"No vacancy, no vacancy,"},{"s":58.17,"e":63.04,"text":"For a voice that takes the air from me."},{"s":63.04,"e":67.66,"text":"I choose my hours, I choose my light,"},{"s":67.66,"e":71.91,"text":"I lock the door and sleep tonight."},{"s":71.91,"e":74.78,"text":"No vacancy, no vacancy,"},{"s":74.78,"e":79.28,"text":"My mind is mine, and I hold the key."},{"s":79.28,"e":84.53,"text":"You can call it fate; I can call a friend."},{"s":84.53,"e":87.28,"text":"(Male: Call a friend.)"},{"s":87.28,"e":92.9,"text":"You can say “forever”; I can say “this ends.”"},{"s":92.9,"e":95.15,"text":"(Male: This ends.)"},{"s":95.15,"e":99.65,"text":"If a room wants loyalty at any cost,"},{"s":99.65,"e":105.02,"text":"I can leave the room and still not be lost."},{"s":105.02,"e":109.89,"text":"No shadow owns me, no deadline decides;"},{"s":109.89,"e":114.51,"text":"I check what's real and take my time."},{"s":114.51,"e":119.14,"text":"Male: What if the feeling comes back?"},{"s":119.14,"e":124.13,"text":"Female: Then we breathe and let it pass."},{"s":124.13,"e":128.01,"text":"Male: What if they knock again?"},{"s":128.01,"e":132.63,"text":"Female: We don't have to let them in."},{"s":132.63,"e":137.88,"text":"Together: One clear no. One steady breath."},{"s":137.88,"e":142.25,"text":"We get to choose what happens next."},{"s":142.25,"e":145.12,"text":"No vacancy, no vacancy,"},{"s":145.12,"e":149.99,"text":"For a voice that takes the air from me."},{"s":149.99,"e":154.62,"text":"I choose my hours, I choose my light,"},{"s":154.62,"e":158.86,"text":"I lock the door and sleep tonight."},{"s":158.86,"e":161.74,"text":"No vacancy, no vacancy,"},{"s":161.74,"e":166.23,"text":"My mind is mine, and I hold the key."},{"s":166.23,"e":171.11,"text":"The clock can tick. The phone can ring."},{"s":171.11,"e":174.98,"text":"I don't owe either one a thing."}],"duration":175.48,"source":"estimated","generatedAt":null}