"s":85.53,"e":90.97,"text":"LAST WORD — gone like the night,"},{"s":90.97,"e":97.77,"text":"Everything quiet, then suddenly stirred—"},{"s":97.77,"e":105.08,"text":"The whole world changes with the last word."},{"s":105.08,"e":111.88,"text":"Pen on the page and a pulse in the room,"},{"s":111.88,"e":120.55,"text":"Letters like stars cutting holes through the gloom,"},{"s":120.55,"e":127.18,"text":"Blink and it vanishes, quick as a sign,"},{"s":127.18,"e":135.34,"text":"A silver little fracture at the edge of my mind."},{"s":135.34,"e":139.25,"text":"Don’t call it prophecy."},{"s":139.25,"e":142.66,"text":"Don’t call it proof."},{"s":142.66,"e":146.57,"text":"Just one strange second"},{"s":146.57,"e":150.31,"text":"cutting clean through."},{"s":150.31,"e":155.41,"text":"LAST WORD — light in the dark,"},{"s":155.41,"e":161.02,"text":"LAST WORD — thunder from a spark,"},{"s":161.02,"e":166.97,"text":"No explanation, no lesson inferred,"},{"s":166.97,"e":173.94,"text":"Just me and the moment and the last word."},{"s":173.94,"e":175.64,"text":"One flash."},{"s":175.64,"e":177.51,"text":"One breath."},{"s":177.51,"e":180.4,"text":"One line unheard."},{"s":180.4,"e":183.8,"text":"Then darkness again—"},{"s":183.8,"e":185.5,"text":"LAST WORD."}],"duration":186,"source":"estimated","generatedAt":null}