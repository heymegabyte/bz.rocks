47,"e":298.02,"line":81},{"w":"standing","s":298.02,"e":298.9,"line":81},{"w":"be","s":298.9,"e":299.12,"line":81},{"w":"you","s":299.12,"e":299.44,"line":81},{"w":"and","s":299.44,"e":299.77,"line":81},{"w":"me.","s":299.77,"e":300.1,"line":81},{"w":"When","s":300.1,"e":300.53,"line":82},{"w":"the","s":300.53,"e":300.85,"line":82},{"w":"red","s":300.85,"e":301.17,"line":82},{"w":"moon","s":301.17,"e":301.59,"line":82},{"w":"rises—","s":301.59,"e":302.23,"line":82},{"w":"I’ll","s":302.23,"e":302.66,"line":83},{"w":"race","s":302.66,"e":303.1,"line":83},{"w":"to","s":303.1,"e":303.31,"line":83},{"w":"the","s":303.31,"e":303.64,"line":83},{"w":"tree.","s":303.64,"e":304.18,"line":83},{"w":"When","s":304.18,"e":304.6,"line":84},{"w":"the","s":304.6,"e":304.92,"line":84},{"w":"last","s":304.92,"e":305.34,"line":84},{"w":"bell","s":305.34,"e":305.76,"line":84},{"w":"rings—","s":305.76,"e":306.4,"line":84},{"w":"Keep","s":306.4,"e":306.81,"line":85},{"w":"waiting","s":306.81,"e":307.55,"line":85},{"w":"for","s":307.55,"e":307.86,"line":85},{"w":"me.","s":307.86,"e":308.17,"line":85},{"w":"When","s":308.17,"e":308.58,"line":86},{"w":"the","s":308.58,"e":308.88,"line":86},{"w":"heavens","s":308.88,"e":309.6,"line":86},{"w":"break—","s":309.6,"e":310.21,"line":86},{"w":"You’re","s":310.21,"e":310.82,"line":87},{"w":"where","s":310.82,"e":311.33,"line":87},{"w":"I","s":311.33,"e":311.54,"line":87},{"w":"will","s":311.54,"e":311.94,"line":87},{"w":"be.","s":311.94,"e":312.25,"line":87},{"w":"At","s":312.25,"e":312.47,"line":88},{"w":"the","s":312.47,"e":312.81,"line":88},{"w":"end","s":312.81,"e":313.14,"line":88},{"w":"of","s":313.14,"e":313.36,"line":88},{"w":"the","s":313.36,"e":313.7,"line":88},{"w":"earth,","s":313.7,"e":314.37,"line":88},{"w":"we’ll","s":314.37,"e":314.92,"line":88},{"w":"begin","s":314.92,"e":315.48,"line":88},{"w":"by","s":315.48,"e":315.7,"line":88},{"w":"the","s":315.7,"e":316.04,"line":88},{"w":"tree.","s":316.04,"e":316.59,"line":88},{"w":"When","s":316.59,"e":317.01,"line":89},{"w":"the","s":317.01,"e":317.31,"line":89},{"w":"radios","s":317.31,"e":317.93,"line":89},{"w":"cease—","s":317.93,"e":318.55,"line":89},{"w":"When","s":318.55,"e":318.98,"line":90},{"w":"the","s":318.98,"e":319.3,"line":90},{"w":"world","s":319.3,"e":319.84,"line":90},{"w":"sets","s":319.84,"e":320.27,"line":90},{"w":"us","s":320.27,"e":320.49,"line":90},{"w":"free—","s":320.49,"e":321.03,"line":90},{"w":"Meet","s":321.03,"e":321.47,"line":91},{"w":"me,","s":321.47,"e":321.8,"line":91},{"w":"my","s":321.8,"e":322.02,"line":91},{"w":"love,","s":322.02,"e":322.57,"line":91},{"w":"by","s":322.57,"e":322.79,"line":91},{"w":"the","s":322.79,"e":323.12,"line":91},{"w":"Mercy","s":323.12,"e":323.67,"line":91},{"w":"Tree.","s":323.67,"e":324.22,"line":91}],"lines":[{"s":1.2,"e":5.19,"text":"When the red moon rises and the radios cease,"},{"s":5.19,"e":9.45,"text":"Meet me by the old tree where we promised peace."},{"s":9.45,"e":14.32,"text":"When the black birds scatter and the bright stars flee,"},{"s":14.32,"e":17.87,"text":"I’ll follow your fire to the Mercy Tree."},{"s":17.87,"e":21.86,"text":"Sirens sing sorrow through shattered streets,"},{"s":21.86,"e":25.32,"text":"Cold concrete quivers beneath our feet."},{"s":25.32,"e":29.31,"text":"Lightning leaves letters of light in the sky,"},{"s":29.31,"e":33.83,"text":"But I’ll bring the blanket—don’t bother asking why."},{"s":33.83,"e":37.82,"text":"Bring that blue bracelet I bought by the bay,"},{"s":37.82,"e":41.9,"text":"I’ll bring every word I was frightened to say."},{"s":41.9,"e":46.51,"text":"I’ll wear the white dress with the wildflower seams,"},{"s":46.51,"e":50.77,"text":"And carry the compass that points to our dreams."},{"s":50.77,"e":54.93,"text":"Past the fallen fountain, past fire and debris,"},{"s":54.93,"e":59.19,"text":"Follow the fox prints that flow toward the tree."},{"s":59.19,"e":63,"text":"Past panic and prophets predicting the sea,"},{"s":63,"e":67.35,"text":"I’ll run through the ruin—just wait there for me."},{"s":67.35,"e":70.98,"text":"If heaven is hiding, I’ll hold you below."},{"s":70.98,"e":75.06,"text":"If daylight is dying, I’ll still see you glow."},{"s":75.06,"e":79.23,"text":"If time takes the towns and the towers we knew—"},{"s":79.23,"e":83.66,"text":"Then time can take everything, everything but you."},{"s":83.66,"e":85.97,"text":"MEET ME BY THE MERCY TREE,"},{"s":85.97,"e":90.22,"text":"Where your name is carved beside the name of me."},{"s":90.22,"e":94.83,"text":"When the whole world ends and the wild winds scream,"},{"s":94.83,"e":98.74,"text":"We’ll be two true hearts in the final scene."},{"s":98.74,"e":101.04,"text":"MEET ME BY THE MERCY TREE,"},{"s":101.04,"e":104.77,"text":"Where the roots run deep through eternity."},{"s":104.77,"e":108.49,"text":"If the stars all fall and the oceans flee,"},{"s":108.49,"e":112.21,"text":"Let the last thing standing be you and me."},{"s":112.21,"e":113.19,"text":"You and me—"},{"s":113.19,"e":114.78,"text":"By the Mercy Tree—"},{"s":114.78,"e":115.67,"text":"Endlessly—"},{"s":115.67,"e":117.62,"text":"Where you promised me—"},{"s":117.62,"e":121.7,"text":"If the world won’t wake, we’ll wake the dream,"},{"s":121.7,"e":124.89,"text":"Holding hope beneath the Mercy Tree."},{"s":124.89,"e":127.91,"text":"Ash falls softly like silver snow,"},{"s":127.91,"e":132.16,"text":"Still, through the smoke, I can see where to go."},{"s":132.16,"e":135.71,"text":"Maps may be meaningless, miles may bend,"},{"s":135.71,"e":139.61,"text":"Follow my heartbeat—it knows where they end."},{"s":139.61,"e":142.72,"text":"Rivers are rising, roads disappear,"},{"s":142.72,"e":146.88,"text":"But love leaves a lantern whenever you’re near."},{"s":146.88,"e":150.52,"text":"Mountains may crumble and monuments fall,"},{"s":150.52,"e":155.13,"text":"I’ll write you a message on what’s left of the wall."},{"s":155.13,"e":159.3,"text":"“Wait where the willow wears ribbons of white.”"},{"s":159.3,"e":163.73,"text":"“Wait where our initials still live in the light.”"},{"s":163.73,"e":168.16,"text":"“Wait where you kissed me that warm summer night.”"},{"s":168.16,"e":172.69,"text":"“I’ll wait through forever—I’ll make it all right.”"},{"s":172.69,"e":176.32,"text":"If heaven is hiding, I’ll hold you below."},{"s":176.32,"e":180.4,"text":"If daylight is dying, I’ll still see you glow."},{"s":180.4,"e":184.57,"text":"If time takes the towns and the towers we knew—"},{"s":184.57,"e":189,"text":"Then time can take everything, everything but you."},{"s":189,"e":191.31,"text":"MEET ME BY THE MERCY TREE,"},{"s":191.31,"e":195.56,"text":"Where your name is carved beside the name of me."},{"s":195.56,"e":200.17,"text":"When the whole world ends and the wild winds scream,"},{"s":200.17,"e":204.07,"text":"We’ll be two true hearts in the final scene."},{"s":204.07,"e":206.38,"text":"MEET ME BY THE MERCY TREE,"},{"s":206.38,"e":210.1,"text":"Where the roots run deep through eternity."},{"s":210.1,"e":213.83,"text":"If the stars all fall and the oceans flee,"},{"s":213.83,"e":217.55,"text":"Let the last thing standing be you and me."},{"s":217.55,"e":221.54,"text":"Five things I see: your face, then the flame."},{"s":221.54,"e":225.27,"text":"Four things I feel: your fingers, my name."},{"s":225.27,"e":229.34,"text":"Three things I hear: the wind and your prayer."},{"s":229.34,"e":233.6,"text":"Two steady hearts saying, “I’ll meet you there.”"},{"s":233.6,"e":237.5,"text":"One final truth when the future turns black—"},{"s":237.5,"e":241.67,"text":"Love leaves a trail that will lead lovers back."},{"s":241.67,"e":245.39,"text":"No kings, no kingdoms, no gold, no decree—"},{"s":245.39,"e":249.65,"text":"Could keep me from coming back home to our tree."},{"s":249.65,"e":253.11,"text":"I see you running through radiant rain!"},{"s":253.11,"e":257.01,"text":"I see you waiting through wildfire and pain!"},{"s":257.01,"e":260.56,"text":"The sky splits open—the skyline is gone!"},{"s":260.56,"e":264.37,"text":"But under our branches, the birds carry on!"},{"s":264.37,"e":265.08,"text":"No fear—"},{"s":265.08,"e":265.96,"text":"No flight—"},{"s":265.96,"e":267.47,"text":"No final goodbye—"},{"s":267.47,"e":271.55,"text":"Just love lifting louder than thunder can cry!"},{"s":271.55,"e":273.86,"text":"MEET ME BY THE MERCY TREE,"},{"s":273.86,"e":278.11,"text":"Where your name is carved beside the name of me."},{"s":278.11,"e":282.72,"text":"When the whole world ends and the wild winds scream,"},{"s":282.72,"e":286.62,"text":"We’ll be two true hearts in the final scene."},{"s":286.62,"e":288.93,"text":"MEET ME BY THE MERCY TREE,"},{"s":288.93,"e":292.65,"text":"Where the roots run deep through eternity."},{"s":292.65,"e":296.38,"text":"If the stars all fall and the oceans flee,"},{"s":296.38,"e":300.1,"text":"Let the last thing standing be you and me."},{"s":300.1,"e":302.23,"text":"When the red moon rises—"},{"s":302.23,"e":304.18,"text":"I’ll race to the tree."},{"s":304.18,"e":306.4,"text":"When the last bell rings—"},{"s":306.4,"e":308.17,"text":"Keep waiting for me."},{"s":308.17,"e":310.21,"text":"When the heavens break—"},{"s":310.21,"e":312.25,"text":"You’re where I will be."},{"s":312.25,"e":316.59,"text":"At the end of the earth, we’ll begin by the tree."},{"s":316.59,"e":318.55,"text":"When the radios cease—"},{"s":318.55,"e":321.03,"text":"When the world sets us free—"},{"s":321.03,"e":324.22,"text":"Meet me, my love, by the Mercy Tree."}],"duration":324.72,"source":"estimated","generatedAt":null}