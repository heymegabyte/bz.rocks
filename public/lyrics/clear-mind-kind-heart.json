3.24,"e":303.44,"line":93},{"w":"perfect","s":303.44,"e":304.13,"line":93},{"w":"mood","s":304.13,"e":304.53,"line":93},{"w":"needed","s":304.53,"e":305.13,"line":93},{"w":"to","s":305.13,"e":305.33,"line":93},{"w":"make","s":305.33,"e":305.72,"line":93},{"w":"a","s":305.72,"e":305.92,"line":93},{"w":"small","s":305.92,"e":306.42,"line":93},{"w":"start—","s":306.42,"e":307.02,"line":93},{"w":"One","s":307.02,"e":307.3,"line":94},{"w":"useful","s":307.3,"e":307.88,"line":94},{"w":"action,","s":307.88,"e":308.55,"line":94},{"w":"one","s":308.55,"e":308.84,"line":94},{"w":"wide-open","s":308.84,"e":309.71,"line":94},{"w":"heart.","s":309.71,"e":310.29,"line":94},{"w":"Soft","s":310.29,"e":310.66,"line":95},{"w":"shoulders.","s":310.66,"e":311.6,"line":95},{"w":"Steady","s":311.6,"e":312.17,"line":95},{"w":"feet.","s":312.17,"e":312.63,"line":95},{"w":"Something","s":312.63,"e":313.53,"line":96},{"w":"good","s":313.53,"e":313.93,"line":96},{"w":"is","s":313.93,"e":314.13,"line":96},{"w":"here","s":314.13,"e":314.53,"line":96},{"w":"with","s":314.53,"e":314.93,"line":96},{"w":"me.","s":314.93,"e":315.23,"line":96},{"w":"The","s":315.23,"e":315.53,"line":97},{"w":"song","s":315.53,"e":315.93,"line":97},{"w":"fades","s":315.93,"e":316.43,"line":97},{"w":"softly.","s":316.43,"e":317.13,"line":97},{"w":"One","s":317.13,"e":317.43,"line":97},{"w":"task","s":317.43,"e":317.82,"line":97},{"w":"stays.","s":317.82,"e":318.42,"line":97},{"w":"I’ll","s":318.42,"e":318.83,"line":98},{"w":"take","s":318.83,"e":319.24,"line":98},{"w":"the","s":319.24,"e":319.54,"line":98},{"w":"first","s":319.54,"e":320.05,"line":98},{"w":"step","s":320.05,"e":320.46,"line":98},{"w":"while","s":320.46,"e":320.97,"line":98},{"w":"the","s":320.97,"e":321.27,"line":98},{"w":"last","s":321.27,"e":321.68,"line":98},{"w":"note","s":321.68,"e":322.09,"line":98},{"w":"plays.","s":322.09,"e":322.7,"line":98}],"lines":[{"s":1.2,"e":3.55,"text":"Soft shoulders. Steady feet."},{"s":3.55,"e":6.4,"text":"Bring the breath back to the beat."},{"s":6.4,"e":8.92,"text":"Thumb and two fingertips meet—"},{"s":8.92,"e":11.77,"text":"Come back kindly. Come back to me."},{"s":11.77,"e":15.79,"text":"Sun through the shutters, a stripe on my sleeve,"},{"s":15.79,"e":19.74,"text":"A small, simple sweetness I let myself receive."},{"s":19.74,"e":23.76,"text":"I step through the door of that room in my mind,"},{"s":23.76,"e":27.62,"text":"Make space for my feelings, let values decide."},{"s":27.62,"e":31.31,"text":"No switch for somebody, no dial for the day;"},{"s":31.31,"e":34.75,"text":"My power is choosing the part I can play."},{"s":34.75,"e":38.36,"text":"Fear gives a forecast; I check what I know,"},{"s":38.36,"e":41.88,"text":"Find firmer footing, then see where to go."},{"s":41.88,"e":45.74,"text":"Thumb to two fingers, feet finding the ground,"},{"s":45.74,"e":49.35,"text":"One easy breath; hear the world all around."},{"s":49.35,"e":53.54,"text":"I name what I’m feeling; I choose one small thing—"},{"s":53.54,"e":56.06,"text":"Touch, breathe, choose, begin."},{"s":56.06,"e":58.82,"text":"Clear mind, kind heart—here I go,"},{"s":58.82,"e":63.1,"text":"Small steps, sweet sparks—let the good things grow."},{"s":63.1,"e":65.53,"text":"Oh-oh, let a little light in,"},{"s":65.53,"e":68.55,"text":"Touch, breathe, choose, begin again."},{"s":68.55,"e":71.91,"text":"I make room for joy; I make room to try,"},{"s":71.91,"e":75.1,"text":"Feet on the floor, let my spirit rise."},{"s":75.1,"e":78.45,"text":"Use my gifts for good, let kindness win—"},{"s":78.45,"e":81.47,"text":"Clear mind, kind heart, begin again."},{"s":81.47,"e":84.91,"text":"Phone face down, put a page in the light,"},{"s":84.91,"e":88.6,"text":"One tab, one task—not my whole life tonight."},{"s":88.6,"e":92.21,"text":"Five minutes moving, then check how I feel,"},{"s":92.21,"e":96.23,"text":"A little less wishing, make one good thing real."},{"s":96.23,"e":100.01,"text":"I picture the process, not praise at the end:"},{"s":100.01,"e":103.7,"text":"The draft, the decision, the message I send."},{"s":103.7,"e":107.72,"text":"When focus goes floating, no fight and no shame,"},{"s":107.72,"e":111.41,"text":"I notice, come nearer, and start once again."},{"s":111.41,"e":115.19,"text":"A stretch by the window, a sip, a small song,"},{"s":115.19,"e":119.05,"text":"Some rest in the rhythm; no race all day long."},{"s":119.05,"e":122.57,"text":"I savor small wins; let satisfaction stay—"},{"s":122.57,"e":127.02,"text":"There’s room for some laughter while building my day."},{"s":127.02,"e":130.79,"text":"The task isn’t proof that I’m worthy of care;"},{"s":130.79,"e":134.82,"text":"I’m worthy already, with work still right there."},{"s":134.82,"e":139.09,"text":"So progress gets patience, and pleasure gets space;"},{"s":139.09,"e":142.7,"text":"I’m finding my rhythm, not forcing my pace."},{"s":142.7,"e":144.21,"text":"What is my signal?"},{"s":144.21,"e":146.22,"text":"This touch, this breath."},{"s":146.22,"e":147.73,"text":"Where is my power?"},{"s":147.73,"e":149.33,"text":"My next small step."},{"s":149.33,"e":150.92,"text":"What am I choosing?"},{"s":150.92,"e":152.68,"text":"One worthwhile thing."},{"s":152.68,"e":155.2,"text":"Touch, breathe, choose, begin."},{"s":155.2,"e":157.97,"text":"Clear mind, kind heart—here I go,"},{"s":157.97,"e":162.24,"text":"Small steps, sweet sparks—let the good things grow."},{"s":162.24,"e":164.68,"text":"Oh-oh, let a little light in,"},{"s":164.68,"e":167.7,"text":"Touch, breathe, choose, begin again."},{"s":167.7,"e":171.05,"text":"I make room for joy; I make room to try,"},{"s":171.05,"e":174.24,"text":"Feet on the floor, let my spirit rise."},{"s":174.24,"e":177.59,"text":"Use my gifts for good, let kindness win—"},{"s":177.59,"e":180.61,"text":"Clear mind, kind heart, begin again."},{"s":180.61,"e":185.06,"text":"My heart brings the feeling; my mind checks the view,"},{"s":185.06,"e":188.58,"text":"My values remind me what love ought to do."},{"s":188.58,"e":192.61,"text":"Let courage create; let compassion come through,"},{"s":192.61,"e":195.79,"text":"Use what I know for the good I can do."},{"s":195.79,"e":200.32,"text":"Let brilliance build bridges, let strong hands repair,"},{"s":200.32,"e":204.01,"text":"Let careful attention say, “Somebody cares.”"},{"s":204.01,"e":208.54,"text":"Speak truth without cruelty; stand firm without spite,"},{"s":208.54,"e":212.49,"text":"Let power mean patience, not proving I’m right."},{"s":212.49,"e":216.01,"text":"Kind, clear boundaries; a calm, honest no—"},{"s":216.01,"e":219.7,"text":"Respect for us both in the way that we grow."},{"s":219.7,"e":223.39,"text":"No need to be flawless, no need to be grand;"},{"s":223.39,"e":227.33,"text":"Sometimes doing good means just lending a hand."},{"s":227.33,"e":231.19,"text":"I practice in peace; I return when it’s rough."},{"s":231.19,"e":235.55,"text":"A small step still counts when the going gets tough."},{"s":235.55,"e":239.16,"text":"A cue to come closer, not force how I feel;"},{"s":239.16,"e":243.27,"text":"A breath and a choice, something simple and real."},{"s":243.27,"e":246.71,"text":"I don’t have to glow to be growing today."},{"s":246.71,"e":250.31,"text":"I can ask for a hand; I can find a new way."},{"s":250.31,"e":253.75,"text":"I rehearse returning, not winning a race;"},{"s":253.75,"e":257.53,"text":"Each gentle beginning gives patience a place."},{"s":257.53,"e":258.79,"text":"Touch—remember."},{"s":258.79,"e":260.04,"text":"Breathe—arrive."},{"s":260.04,"e":261.72,"text":"Choose what matters."},{"s":261.72,"e":263.4,"text":"Let good come alive."},{"s":263.4,"e":265.16,"text":"Calm isn’t a contest."},{"s":265.16,"e":266.59,"text":"Joy isn’t a debt."},{"s":266.59,"e":268.26,"text":"This moment has room"},{"s":268.26,"e":270.19,"text":"For my next small step."},{"s":270.19,"e":272.96,"text":"Clear mind, kind heart—here I go,"},{"s":272.96,"e":277.24,"text":"Small steps, sweet sparks—let the good things grow."},{"s":277.24,"e":279.67,"text":"Oh-oh, let a little light in,"},{"s":279.67,"e":282.69,"text":"Touch, breathe, choose, begin again."},{"s":282.69,"e":286.05,"text":"I make room for joy; I make room to try,"},{"s":286.05,"e":289.23,"text":"Feet on the floor, let my spirit rise."},{"s":289.23,"e":292.59,"text":"Use my gifts for good, let kindness win—"},{"s":292.59,"e":295.61,"text":"Clear mind, kind heart, begin again."},{"s":295.61,"e":299.72,"text":"More present, more patient, more willing to care,"},{"s":299.72,"e":303.24,"text":"A little more laughter, a little more air."},{"s":303.24,"e":307.02,"text":"No perfect mood needed to make a small start—"},{"s":307.02,"e":310.29,"text":"One useful action, one wide-open heart."},{"s":310.29,"e":312.63,"text":"Soft shoulders. Steady feet."},{"s":312.63,"e":315.23,"text":"Something good is here with me."},{"s":315.23,"e":318.42,"text":"The song fades softly. One task stays."},{"s":318.42,"e":322.7,"text":"I’ll take the first step while the last note plays."}],"duration":323.2,"source":"estimated","generatedAt":null}