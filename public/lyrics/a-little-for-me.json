4},{"w":"do,","s":321.56,"e":321.92,"line":74},{"w":"Leave","s":321.92,"e":322.5,"line":75},{"w":"a","s":322.5,"e":322.73,"line":75},{"w":"little","s":322.73,"e":323.43,"line":75},{"w":"love","s":323.43,"e":323.89,"line":75},{"w":"where","s":323.89,"e":324.47,"line":75},{"w":"the","s":324.47,"e":324.82,"line":75},{"w":"light","s":324.82,"e":325.4,"line":75},{"w":"can","s":325.4,"e":325.75,"line":75},{"w":"get","s":325.75,"e":326.1,"line":75},{"w":"through.","s":326.1,"e":327.03,"line":75},{"w":"The","s":327.03,"e":327.38,"line":76},{"w":"last","s":327.38,"e":327.86,"line":76},{"w":"little","s":327.86,"e":328.57,"line":76},{"w":"notes","s":328.57,"e":329.16,"line":76},{"w":"leave","s":329.16,"e":329.75,"line":76},{"w":"a","s":329.75,"e":329.99,"line":76},{"w":"light","s":329.99,"e":330.58,"line":76},{"w":"in","s":330.58,"e":330.82,"line":76},{"w":"the","s":330.82,"e":331.18,"line":76},{"w":"air,","s":331.18,"e":331.65,"line":76},{"w":"A","s":331.65,"e":331.88,"line":77},{"w":"call,","s":331.88,"e":332.45,"line":77},{"w":"not","s":332.45,"e":332.79,"line":77},{"w":"a","s":332.79,"e":333.02,"line":77},{"w":"scroll:","s":333.02,"e":333.82,"line":77},{"w":"\"I've","s":333.82,"e":334.39,"line":77},{"w":"got","s":334.39,"e":334.74,"line":77},{"w":"time,","s":334.74,"e":335.31,"line":77},{"w":"and","s":335.31,"e":335.65,"line":77},{"w":"I","s":335.65,"e":335.88,"line":77},{"w":"care.\"","s":335.88,"e":336.57,"line":77},{"w":"One","s":336.57,"e":336.91,"line":78},{"w":"small,","s":336.91,"e":337.61,"line":78},{"w":"steady","s":337.61,"e":338.3,"line":78},{"w":"kindness;","s":338.3,"e":339.34,"line":78},{"w":"one","s":339.34,"e":339.69,"line":78},{"w":"thing","s":339.69,"e":340.26,"line":78},{"w":"I","s":340.26,"e":340.49,"line":78},{"w":"can","s":340.49,"e":340.84,"line":78},{"w":"do,","s":340.84,"e":341.19,"line":78},{"w":"Leave","s":341.19,"e":341.77,"line":79},{"w":"a","s":341.77,"e":342,"line":79},{"w":"little","s":342,"e":342.7,"line":79},{"w":"love","s":342.7,"e":343.16,"line":79},{"w":"where","s":343.16,"e":343.74,"line":79},{"w":"the","s":343.74,"e":344.09,"line":79},{"w":"light","s":344.09,"e":344.67,"line":79},{"w":"can","s":344.67,"e":345.02,"line":79},{"w":"get","s":345.02,"e":345.37,"line":79},{"w":"through.","s":345.37,"e":346.3,"line":79}],"lines":[{"s":1.2,"e":5.53,"text":"Soft silver silence, a slow ribbon of light,"},{"s":5.53,"e":9.95,"text":"Let love be a lantern, not lightning tonight."},{"s":9.95,"e":14.18,"text":"No need to perform, no perfection to prove,"},{"s":14.18,"e":18.5,"text":"Make room for a feeling that's free to move."},{"s":18.5,"e":22.73,"text":"Picture a presence that's patient and near,"},{"s":22.73,"e":27.16,"text":"A face, or a feeling, that welcomes you here."},{"s":27.16,"e":31.19,"text":"A seat at the table, a smile at the door,"},{"s":31.19,"e":35.71,"text":"No speech about why you should have done more."},{"s":35.71,"e":40.13,"text":"A cup in the kitchen, the kettle's soft song,"},{"s":40.13,"e":45.05,"text":"A voice saying softly, \"There's room; you belong.\""},{"s":45.05,"e":49.97,"text":"Stay with that sweetness, that small, steady glow,"},{"s":49.97,"e":53.8,"text":"Let it be little; let little love grow."},{"s":53.8,"e":57.83,"text":"I need no gold medals to merit your care,"},{"s":57.83,"e":62.94,"text":"There's room for my rain in the warmth we can share."},{"s":62.94,"e":67.96,"text":"When tenderness takes its own time to come through,"},{"s":67.96,"e":71.99,"text":"I'll leave a light on for me and for you."},{"s":71.99,"e":76.22,"text":"Let love come close, let love come through,"},{"s":76.22,"e":79.95,"text":"A little for me, and a little for you."},{"s":79.95,"e":83.49,"text":"Heart to heart, let the hard day go,"},{"s":83.49,"e":87.52,"text":"Soft as the sunrise, let tenderness grow."},{"s":87.52,"e":91.36,"text":"May you know comfort; may I know peace,"},{"s":91.36,"e":95,"text":"May we give worry a moment's release."},{"s":95,"e":99.03,"text":"Love in the listening, love in the light—"},{"s":99.03,"e":103.06,"text":"Leave a little love in the world tonight."},{"s":103.06,"e":107.29,"text":"Oh, love, love, let the light come through,"},{"s":107.29,"e":110.92,"text":"Oh, love, love, I leave room for you."},{"s":110.92,"e":115.25,"text":"Slow, sweet ripples; a small spark can start"},{"s":115.25,"e":119.28,"text":"A circle of kindness from heart to heart."},{"s":119.28,"e":124.2,"text":"You saved me a seat, slid your chair next to mine,"},{"s":124.2,"e":129.31,"text":"Said, \"Stay for a song; there's no need to be fine.\""},{"s":129.31,"e":134.32,"text":"Thanks for your patience, your presence right here,"},{"s":134.32,"e":139.04,"text":"For warm, willing silence that let me come near."},{"s":139.04,"e":143.57,"text":"Now I set my screen down; I look in your eyes,"},{"s":143.57,"e":148.48,"text":"Ask, \"How are you, really?\" and hear your replies."},{"s":148.48,"e":152.61,"text":"Let listening linger; let laughter arrive,"},{"s":152.61,"e":156.45,"text":"A little less posing, more being alive."},{"s":156.45,"e":161.26,"text":"A message at midnight: \"You're still on my mind,\""},{"s":161.26,"e":166.18,"text":"Fresh fruit at your doorstep, no debt left behind."},{"s":166.18,"e":170.41,"text":"No grand declarations, just good that I do,"},{"s":170.41,"e":175.13,"text":"Let love leave a footprint in following through."},{"s":175.13,"e":179.35,"text":"Let love come close, let love come through,"},{"s":179.35,"e":183.09,"text":"A little for me, and a little for you."},{"s":183.09,"e":186.63,"text":"Heart to heart, let the hard day go,"},{"s":186.63,"e":190.66,"text":"Soft as the sunrise, let tenderness grow."},{"s":190.66,"e":194.5,"text":"May you know comfort; may I know peace,"},{"s":194.5,"e":198.13,"text":"May we give worry a moment's release."},{"s":198.13,"e":202.16,"text":"Love in the listening, love in the light—"},{"s":202.16,"e":206.2,"text":"Leave a little love in the world tonight."},{"s":206.2,"e":210.82,"text":"The stranger beside me has storms of their own,"},{"s":210.82,"e":214.75,"text":"A whole hidden history I've never known."},{"s":214.75,"e":219.17,"text":"May they find friendship; may they find rest,"},{"s":219.17,"e":223.99,"text":"A little less burden, more breath in their chest."},{"s":223.99,"e":228.12,"text":"From one quiet kitchen to cities of light,"},{"s":228.12,"e":232.84,"text":"May kindness keep crossing the distance tonight."},{"s":232.84,"e":237.26,"text":"With room to be different and room to belong,"},{"s":237.26,"e":241.49,"text":"Our separate stories can share in one song."},{"s":241.49,"e":246.11,"text":"Love leaves us breathing, with room to be real,"},{"s":246.11,"e":250.83,"text":"No debt and no deadline for what we should feel."},{"s":250.83,"e":255.55,"text":"When grief joins the gathering, give it a chair,"},{"s":255.55,"e":259.88,"text":"No smile has to silence the sorrow we share."},{"s":259.88,"e":264.11,"text":"May I meet myself with the care I give you,"},{"s":264.11,"e":269.02,"text":"May you meet the morning with hope coming through."},{"s":269.02,"e":273.05,"text":"May we make moments of mercy take flight,"},{"s":273.05,"e":277.77,"text":"May love leave a little more light here tonight."},{"s":277.77,"e":282,"text":"Let love come close, let love come through,"},{"s":282,"e":285.74,"text":"A little for me, and a little for you."},{"s":285.74,"e":289.27,"text":"Heart to heart, let the hard day go,"},{"s":289.27,"e":293.31,"text":"Soft as the sunrise, let tenderness grow."},{"s":293.31,"e":297.14,"text":"May you know comfort; may I know peace,"},{"s":297.14,"e":300.78,"text":"May we give worry a moment's release."},{"s":300.78,"e":304.81,"text":"Love in the listening, love in the light—"},{"s":304.81,"e":308.84,"text":"Leave a little love in the world tonight."},{"s":308.84,"e":313.17,"text":"Not just a feeling that fades with the song,"},{"s":313.17,"e":317.79,"text":"But a hand held out when the hard road is long."},{"s":317.79,"e":321.92,"text":"I'll carry this kindness in all that I do,"},{"s":321.92,"e":327.03,"text":"Leave a little love where the light can get through."},{"s":327.03,"e":331.65,"text":"The last little notes leave a light in the air,"},{"s":331.65,"e":336.57,"text":"A call, not a scroll: \"I've got time, and I care.\""},{"s":336.57,"e":341.19,"text":"One small, steady kindness; one thing I can do,"},{"s":341.19,"e":346.3,"text":"Leave a little love where the light can get through."}],"duration":346.8,"source":"estimated","generatedAt":null}