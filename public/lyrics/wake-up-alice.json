"s":293.48,"e":293.72,"line":89},{"w":"mirror","s":293.72,"e":294.47,"line":89},{"w":"between.","s":294.47,"e":295.46,"line":89},{"w":"Just","s":295.46,"e":295.93,"line":90},{"w":"morning.","s":295.93,"e":296.89,"line":90},{"w":"Just","s":296.89,"e":297.37,"line":91},{"w":"breath.","s":297.37,"e":298.21,"line":91},{"w":"Just","s":298.21,"e":298.69,"line":92},{"w":"Alice—","s":298.69,"e":299.42,"line":92},{"w":"awake.","s":299.42,"e":300.3,"line":93}],"lines":[{"s":1.2,"e":2.08,"text":"Alice…"},{"s":2.08,"e":5.71,"text":"The rabbit never owned the clock."},{"s":5.71,"e":9.23,"text":"The mirror never knew your name."},{"s":9.23,"e":10.33,"text":"Come home."},{"s":10.33,"e":15.07,"text":"White walls, wild woods, winter-blue light,"},{"s":15.07,"e":19.91,"text":"Watch all the wonders dissolve in the night."},{"s":19.91,"e":24.75,"text":"Rabbit runs circles, but circles don’t lead,"},{"s":24.75,"e":29.04,"text":"Roses turn red when you water the seed."},{"s":29.04,"e":33.44,"text":"Tea cups are talking, the table is long,"},{"s":33.44,"e":37.84,"text":"Everybody’s certain, everybody is wrong."},{"s":37.84,"e":42.8,"text":"Cheshire keeps grinning like truth is a game,"},{"s":42.8,"e":48.08,"text":"But you know your heartbeat, you know your name."},{"s":48.08,"e":52.04,"text":"Feel the floor underneath your feet,"},{"s":52.04,"e":56,"text":"Count four breaths, hear four beats."},{"s":56,"e":60.29,"text":"Touch the ground, let the colors clear—"},{"s":60.29,"e":64.04,"text":"What you can feel is already here."},{"s":64.04,"e":67.12,"text":"Wake up, Alice, wake up now,"},{"s":67.12,"e":71.08,"text":"Let the painted kingdom tumble down."},{"s":71.08,"e":74.71,"text":"No looking glass, no rabbit hole,"},{"s":74.71,"e":78.78,"text":"No Queen of Hearts can own your soul."},{"s":78.78,"e":82.3,"text":"Wake up, Alice, follow my voice,"},{"s":82.3,"e":86.48,"text":"Reality waits—you still have a choice."},{"s":86.48,"e":91.44,"text":"Stars can shine without swallowing you whole,"},{"s":91.44,"e":93.86,"text":"Come back to the room,"},{"s":93.86,"e":96.39,"text":"Come back to your body,"},{"s":96.39,"e":98.04,"text":"Come back home."},{"s":98.04,"e":102.55,"text":"Mad Hatter says midnight happens at noon,"},{"s":102.55,"e":107.39,"text":"The moon says the ocean is chasing the moon."},{"s":107.39,"e":112.12,"text":"Cards build a castle, then call it the sky,"},{"s":112.12,"e":117.63,"text":"But paper kingdoms collapse when you ask them why."},{"s":117.63,"e":122.03,"text":"Name five things that your eyes can see,"},{"s":122.03,"e":127.09,"text":"Four that you touch, three sounds around thee,"},{"s":127.09,"e":131.6,"text":"Two things you smell, one truth you know:"},{"s":131.6,"e":136.11,"text":"You are right here. You don’t have to go."},{"s":136.11,"e":139.75,"text":"Let every impossible hallway end,"},{"s":139.75,"e":144.81,"text":"Let every strange shadow become just a friend."},{"s":144.81,"e":150.42,"text":"You don’t have to fight every thought that appears—"},{"s":150.42,"e":156.25,"text":"Let it pass like a cloud; let the daylight come near."},{"s":156.25,"e":159.33,"text":"Wake up, Alice, wake up now,"},{"s":159.33,"e":163.3,"text":"Let the painted kingdom tumble down."},{"s":163.3,"e":166.93,"text":"No looking glass, no rabbit hole,"},{"s":166.93,"e":171,"text":"No Queen of Hearts can own your soul."},{"s":171,"e":174.52,"text":"Wake up, Alice, follow my voice,"},{"s":174.52,"e":178.7,"text":"Reality waits—you still have a choice."},{"s":178.7,"e":183.65,"text":"Stars can shine without swallowing you whole,"},{"s":183.65,"e":186.07,"text":"Come back to the room,"},{"s":186.07,"e":188.61,"text":"Come back to your body,"},{"s":188.61,"e":190.26,"text":"Come back home."},{"s":190.26,"e":193.34,"text":"The rabbit is only a rabbit."},{"s":193.34,"e":196.2,"text":"The clock is only a clock."},{"s":196.2,"e":200.6,"text":"A door is a door when you turn the lock."},{"s":200.6,"e":202.8,"text":"The roses are roses."},{"s":202.8,"e":204.89,"text":"The sky is the sky."},{"s":204.89,"e":207.86,"text":"A thought can feel enormous"},{"s":207.86,"e":212.37,"text":"And still not be a fact inside your mind."},{"s":212.37,"e":213.59,"text":"Breathe in—"},{"s":213.59,"e":215.02,"text":"There is air."},{"s":215.02,"e":216.34,"text":"Breathe out—"},{"s":216.34,"e":217.88,"text":"You are there."},{"s":217.88,"e":220.19,"text":"Your hands are yours."},{"s":220.19,"e":222.17,"text":"Your name is true."},{"s":222.17,"e":225.14,"text":"The world doesn’t disappear"},{"s":225.14,"e":228.55,"text":"Just because it frightened you."},{"s":228.55,"e":230.42,"text":"“Was I dreaming?”"},{"s":230.42,"e":231.3,"text":"Maybe."},{"s":231.3,"e":232.84,"text":"“Was it real?”"},{"s":232.84,"e":234.27,"text":"It felt real."},{"s":234.27,"e":236.25,"text":"“Then where am I?”"},{"s":236.25,"e":237.13,"text":"Here."},{"s":237.13,"e":238.79,"text":"“And who am I?”"},{"s":238.79,"e":239.67,"text":"Alice."},{"s":239.67,"e":243.08,"text":"WAKE UP, ALICE, OPEN YOUR EYES,"},{"s":243.08,"e":248.03,"text":"Morning is breaking through Wonderland skies."},{"s":248.03,"e":252.32,"text":"Let every illusion release its control,"},{"s":252.32,"e":256.5,"text":"You never belonged to the rabbit hole."},{"s":256.5,"e":260.46,"text":"Wake up, Alice, come into the light,"},{"s":260.46,"e":265.64,"text":"You don’t have to conquer the darkness tonight."},{"s":265.64,"e":270.37,"text":"Just follow one heartbeat wherever it goes—"},{"s":270.37,"e":272.9,"text":"One breath, one moment,"},{"s":272.9,"e":275.54,"text":"One thing that you know:"},{"s":275.54,"e":276.97,"text":"You are here."},{"s":276.97,"e":278.29,"text":"You are now."},{"s":278.29,"e":281.92,"text":"You are standing on solid ground."},{"s":281.92,"e":284.34,"text":"Let Wonderland wander,"},{"s":284.34,"e":286.54,"text":"Let Wonderland roam—"},{"s":286.54,"e":289.19,"text":"You can visit the stars…"},{"s":289.19,"e":291.39,"text":"and still come home."},{"s":291.39,"e":292.49,"text":"No rabbit."},{"s":292.49,"e":293.48,"text":"No queen."},{"s":293.48,"e":295.46,"text":"No mirror between."},{"s":295.46,"e":296.89,"text":"Just morning."},{"s":296.89,"e":298.21,"text":"Just breath."},{"s":298.21,"e":299.42,"text":"Just Alice—"},{"s":299.42,"e":300.3,"text":"awake."}],"duration":300.8,"source":"estimated","generatedAt":null}