e":272.69,"line":69},{"w":"in","s":272.69,"e":272.85,"line":69},{"w":"the","s":272.85,"e":273.11,"line":69},{"w":"past.","s":273.11,"e":273.53,"line":69},{"w":"No","s":273.53,"e":273.69,"line":70},{"w":"one's","s":273.69,"e":274.11,"line":70},{"w":"born","s":274.11,"e":274.44,"line":70},{"w":"without","s":274.44,"e":275.01,"line":70},{"w":"a","s":275.01,"e":275.18,"line":70},{"w":"future","s":275.18,"e":275.67,"line":70},{"w":"just","s":275.67,"e":276,"line":70},{"w":"because","s":276,"e":276.58,"line":70},{"w":"they","s":276.58,"e":276.91,"line":70},{"w":"finished","s":276.91,"e":277.57,"line":70},{"w":"last.","s":277.57,"e":277.98,"line":70},{"w":"FEMALE:","s":277.98,"e":278.58,"line":71},{"w":"What","s":278.58,"e":278.91,"line":71},{"w":"if","s":278.91,"e":279.08,"line":71},{"w":"power","s":279.08,"e":279.51,"line":71},{"w":"makes","s":279.51,"e":279.93,"line":71},{"w":"a","s":279.93,"e":280.1,"line":71},{"w":"good","s":280.1,"e":280.44,"line":71},{"w":"man","s":280.44,"e":280.69,"line":71},{"w":"bad?","s":280.69,"e":281.03,"line":71},{"w":"MALE:","s":281.03,"e":281.48,"line":72},{"w":"Then","s":281.48,"e":281.84,"line":72},{"w":"look","s":281.84,"e":282.2,"line":72},{"w":"me","s":282.2,"e":282.38,"line":72},{"w":"in","s":282.38,"e":282.56,"line":72},{"w":"the","s":282.56,"e":282.83,"line":72},{"w":"eyes","s":282.83,"e":283.19,"line":72},{"w":"and","s":283.19,"e":283.46,"line":72},{"w":"bring","s":283.46,"e":283.91,"line":72},{"w":"me","s":283.91,"e":284.09,"line":72},{"w":"back","s":284.09,"e":284.45,"line":72},{"w":"to","s":284.45,"e":284.63,"line":72},{"w":"where","s":284.63,"e":285.08,"line":72},{"w":"we","s":285.08,"e":285.26,"line":72},{"w":"sat.","s":285.26,"e":285.62,"line":72},{"w":"BOTH:","s":285.62,"e":286.05,"line":73},{"w":"From","s":286.05,"e":286.4,"line":73},{"w":"the","s":286.4,"e":286.66,"line":73},{"w":"floor","s":286.66,"e":287.09,"line":73},{"w":"to","s":287.09,"e":287.26,"line":73},{"w":"the","s":287.26,"e":287.52,"line":73},{"w":"front","s":287.52,"e":287.95,"line":73},{"w":"door,","s":287.95,"e":288.38,"line":73},{"w":"hear","s":288.38,"e":288.72,"line":73},{"w":"the","s":288.72,"e":288.98,"line":73},{"w":"thunder,","s":288.98,"e":289.67,"line":73},{"w":"feel","s":289.67,"e":290.01,"line":73},{"w":"the","s":290.01,"e":290.27,"line":73},{"w":"brass—","s":290.27,"e":290.79,"line":73},{"w":"They","s":290.79,"e":291.12,"line":74},{"w":"called","s":291.12,"e":291.62,"line":74},{"w":"us","s":291.62,"e":291.79,"line":74},{"w":"the","s":291.79,"e":292.04,"line":74},{"w":"possessed","s":292.04,"e":292.79,"line":74},{"w":"class;","s":292.79,"e":293.3,"line":74},{"w":"we","s":293.3,"e":293.46,"line":74},{"w":"possessed","s":293.46,"e":294.22,"line":74},{"w":"a","s":294.22,"e":294.38,"line":74},{"w":"voice","s":294.38,"e":294.8,"line":74},{"w":"at","s":294.8,"e":294.97,"line":74},{"w":"last!","s":294.97,"e":295.39,"line":74},{"w":"FEMALE:","s":295.39,"e":295.98,"line":75},{"w":"What","s":295.98,"e":296.32,"line":75},{"w":"if","s":296.32,"e":296.5,"line":75},{"w":"they","s":296.5,"e":296.84,"line":75},{"w":"call","s":296.84,"e":297.18,"line":75},{"w":"you","s":297.18,"e":297.43,"line":75},{"w":"king?","s":297.43,"e":297.86,"line":75},{"w":"MALE:","s":297.86,"e":298.27,"line":76},{"w":"Tell","s":298.27,"e":298.59,"line":76},{"w":"'em","s":298.59,"e":298.83,"line":76},{"w":"I","s":298.83,"e":299,"line":76},{"w":"was","s":299,"e":299.24,"line":76},{"w":"hired—not","s":299.24,"e":299.97,"line":76},{"w":"crowned.","s":299.97,"e":300.62,"line":76}],"lines":[{"s":1.2,"e":3.11,"text":"What If This? What If That?"},{"s":3.11,"e":5.02,"text":"What if this? What if that?"},{"s":5.02,"e":8.98,"text":"What if a smile's a silver knife behind somebody's back?"},{"s":8.98,"e":11.46,"text":"They called us the possessed class."},{"s":11.46,"e":15.21,"text":"I possessed a pen and purpose. That's all I ever had."},{"s":15.21,"e":18.6,"text":"Basement-born, bills blinked red beside the bed,"},{"s":18.6,"e":22.77,"text":"Bosses bought another boat while we were begging to be fed."},{"s":22.77,"e":27.23,"text":"Pawned my pride, patched my pants, practiced pitches past dawn,"},{"s":27.23,"e":29.92,"text":"Put a pocketful of problems in a song."},{"s":29.92,"e":33.46,"text":"The 48 Laws of Power helped me recognize the game,"},{"s":33.46,"e":37.42,"text":"But I wrote one law myself: never profit off their pain."},{"s":37.42,"e":41.17,"text":"The Art of Seduction showed how stories stir a crowd,"},{"s":41.17,"e":45.41,"text":"But I'd never sell a smile I couldn't stand to say out loud."},{"s":45.41,"e":48.59,"text":"The 33 Strategies of War: protect your peace,"},{"s":48.59,"e":52.48,"text":"The 50th Law: face your fear till fear begins to cease."},{"s":52.48,"e":55.81,"text":"Mastery: midnight miles with nobody to applaud,"},{"s":55.81,"e":59.91,"text":"The Laws of Human Nature: find the hurt beneath the fraud."},{"s":59.91,"e":64.08,"text":"The Daily Laws: do the daily; let the little lessons stack,"},{"s":64.08,"e":68.19,"text":"See a crooked system clearly, still refuse to rig it back."},{"s":68.19,"e":70.1,"text":"What if this? What if that?"},{"s":70.1,"e":74.62,"text":"What if your brilliant blueprint turns your heartbeat into math?"},{"s":74.62,"e":78.3,"text":"What if every promise gets a price tag and a plaque?"},{"s":78.3,"e":82.97,"text":"What if you make it to the White House and you never make it back?"},{"s":82.97,"e":85.45,"text":"FEMALE: What if this? What if that?"},{"s":85.45,"e":88.77,"text":"What if the crown's a cage painted like a flag?"},{"s":88.77,"e":93.72,"text":"MALE: What if the doors are only closed 'cause nobody pushed 'em back?"},{"s":93.72,"e":97.47,"text":"I don't need a golden throne; I need a key and a map."},{"s":97.47,"e":101.08,"text":"FEMALE: What if a hero gets addicted to the praise?"},{"s":101.08,"e":105.53,"text":"MALE: Then look me in the eyes and call me out before I change."},{"s":105.53,"e":110.7,"text":"BOTH: From the floor to the front door, hear the thunder, feel the brass—"},{"s":110.7,"e":115.3,"text":"They called us the possessed class; we possessed a voice at last!"},{"s":115.3,"e":118.41,"text":"The Law of Success put a purpose in my palm,"},{"s":118.41,"e":122.86,"text":"Think and Grow Rich gave a vision; work is what kept it strong."},{"s":122.86,"e":126.68,"text":"Outwitting the Devil said don't drift, decide, depart,"},{"s":126.68,"e":130.36,"text":"Built a bold-eyed mastermind from the brokenhearted."},{"s":130.36,"e":134.18,"text":"The Master Key to Riches? Can't unlock it on your own,"},{"s":134.18,"e":138.5,"text":"The Magic Ladder to Success? Every rung is help you've known."},{"s":138.5,"e":142.81,"text":"How to Sell Your Way Through Life: sell a vision, never lies,"},{"s":142.81,"e":146.77,"text":"How to Raise Your Own Salary: let the lowest wages rise."},{"s":146.77,"e":150.95,"text":"Success Through a Positive Mental Attitude: train the mind,"},{"s":150.95,"e":155.19,"text":"Grow Rich! With Peace of Mind: don't leave your soul behind."},{"s":155.19,"e":158.94,"text":"Succeed and Grow Rich Through Persuasion: earn a yes,"},{"s":158.94,"e":163.04,"text":"Don't make a living turning someone else's life to stress."},{"s":163.04,"e":166.86,"text":"You Can Work Your Own Miracles—but miracles take time,"},{"s":166.86,"e":170.68,"text":"A million little acts of trust all stepping into line."},{"s":170.68,"e":174.29,"text":"Library for a lobby, laundromat for campaign halls,"},{"s":174.29,"e":179.03,"text":"Met the mothers, met the mechanics, made a promise: take the calls."},{"s":179.03,"e":183.13,"text":"Greene gave maps of motive; Hill gave focus for the fight,"},{"s":183.13,"e":187.3,"text":"But the people gave me purpose and the courage to be right."},{"s":187.3,"e":189.5,"text":"What if this? And what if that?"},{"s":189.5,"e":193.81,"text":"What if the kids stay hungry while your name's upon a plaque?"},{"s":193.81,"e":198.9,"text":"What if your mother's out of medicine while your mansion shines in gold?"},{"s":198.9,"e":203.08,"text":"What if you stop saying “we” when the power takes its hold?"},{"s":203.08,"e":207.39,"text":"What if you win the White House but forget the way back home?"},{"s":207.39,"e":211.28,"text":"What if all that power leaves you standing there alone?"},{"s":211.28,"e":214.82,"text":"If I forget the floor, I don't deserve the stairs."},{"s":214.82,"e":218.99,"text":"If I start to think I'm king, then I don't belong up there."},{"s":218.99,"e":223.02,"text":"I studied every power play; I don't have to play 'em all."},{"s":223.02,"e":226.77,"text":"Keep asking “what if”—you're the reason I don't fall."},{"s":226.77,"e":231.58,"text":"Campaign cars, crowded calendars, cracked concrete to marble floors,"},{"s":231.58,"e":236.32,"text":"Secret Service, spinning cameras, still I see those basement doors."},{"s":236.32,"e":241.56,"text":"Past the portraits, past the pillars, learned to listen when they'd speak,"},{"s":241.56,"e":245.87,"text":"Kept the names of all my neighbors in my notebook every week."},{"s":245.87,"e":248.91,"text":"No magic, no messiah, no miraculous decree,"},{"s":248.91,"e":253.3,"text":"Just a mandate made of millions saying, “Work for you and me.”"},{"s":253.3,"e":257.54,"text":"The White House door swung open, but I held it like my past—"},{"s":257.54,"e":262.14,"text":"They called us the possessed class; we possessed a voice at last."},{"s":262.14,"e":264.62,"text":"FEMALE: What if this? What if that?"},{"s":264.62,"e":268.22,"text":"What if the next kid needs the ladder that you had?"},{"s":268.22,"e":273.53,"text":"MALE: Then we build a thousand ladders, leave the locked doors in the past."},{"s":273.53,"e":277.98,"text":"No one's born without a future just because they finished last."},{"s":277.98,"e":281.03,"text":"FEMALE: What if power makes a good man bad?"},{"s":281.03,"e":285.62,"text":"MALE: Then look me in the eyes and bring me back to where we sat."},{"s":285.62,"e":290.79,"text":"BOTH: From the floor to the front door, hear the thunder, feel the brass—"},{"s":290.79,"e":295.39,"text":"They called us the possessed class; we possessed a voice at last!"},{"s":295.39,"e":297.86,"text":"FEMALE: What if they call you king?"},{"s":297.86,"e":300.62,"text":"MALE: Tell 'em I was hired—not crowned."}],"duration":301.12,"source":"estimated","generatedAt":null}