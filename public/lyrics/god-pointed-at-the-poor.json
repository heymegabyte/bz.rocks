4,"e":290.91,"line":76},{"w":"FLOOR,","s":290.91,"e":291.47,"line":76},{"w":"AND","s":291.47,"e":291.74,"line":77},{"w":"HE","s":291.74,"e":291.93,"line":77},{"w":"ASKED","s":291.93,"e":292.38,"line":77},{"w":"US","s":292.38,"e":292.57,"line":77},{"w":"ONE","s":292.57,"e":292.84,"line":77},{"w":"LAST","s":292.84,"e":293.21,"line":77},{"w":"QUESTION:","s":293.21,"e":294.04,"line":77},{"w":"'WHAT","s":294.04,"e":294.49,"line":77},{"w":"WAS","s":294.49,"e":294.77,"line":77},{"w":"ALL","s":294.77,"e":295.05,"line":77},{"w":"THAT","s":295.05,"e":295.41,"line":77},{"w":"WORSHIP","s":295.41,"e":296.05,"line":77},{"w":"FOR?'","s":296.05,"e":296.51,"line":77},{"w":"The","s":296.51,"e":296.79,"line":78},{"w":"skies","s":296.79,"e":297.24,"line":78},{"w":"went","s":297.24,"e":297.6,"line":78},{"w":"still;","s":297.6,"e":298.15,"line":78},{"w":"no","s":298.15,"e":298.33,"line":78},{"w":"silver,","s":298.33,"e":298.97,"line":78},{"w":"no","s":298.97,"e":299.15,"line":78},{"w":"gold,","s":299.15,"e":299.6,"line":78},{"w":"Just","s":299.6,"e":299.96,"line":79},{"w":"a","s":299.96,"e":300.14,"line":79},{"w":"child","s":300.14,"e":300.59,"line":79},{"w":"and","s":300.59,"e":300.85,"line":79},{"w":"a","s":300.85,"e":301.03,"line":79},{"w":"calf","s":301.03,"e":301.39,"line":79},{"w":"in","s":301.39,"e":301.57,"line":79},{"w":"the","s":301.57,"e":301.84,"line":79},{"w":"bitter,","s":301.84,"e":302.46,"line":79},{"w":"biting","s":302.46,"e":303,"line":79},{"w":"cold.","s":303,"e":303.44,"line":79},{"w":"One","s":303.44,"e":303.71,"line":80},{"w":"hand","s":303.71,"e":304.07,"line":80},{"w":"pointed","s":304.07,"e":304.7,"line":80},{"w":"toward","s":304.7,"e":305.24,"line":80},{"w":"the","s":305.24,"e":305.5,"line":80},{"w":"lives","s":305.5,"e":305.95,"line":80},{"w":"we'd","s":305.95,"e":306.31,"line":80},{"w":"left","s":306.31,"e":306.67,"line":80},{"w":"outside","s":306.67,"e":307.3,"line":80},{"w":"the","s":307.3,"e":307.56,"line":80},{"w":"door...","s":307.56,"e":308.19,"line":80},{"w":"And","s":308.19,"e":308.47,"line":81},{"w":"God","s":308.47,"e":308.74,"line":81},{"w":"pointed","s":308.74,"e":309.38,"line":81},{"w":"at","s":309.38,"e":309.57,"line":81},{"w":"the","s":309.57,"e":309.84,"line":81},{"w":"poor.","s":309.84,"e":310.3,"line":81}],"lines":[{"s":1.2,"e":4.36,"text":"They said the end would arrive in a flame,"},{"s":4.36,"e":8.13,"text":"But the hungry knew the fire before it had a name."},{"s":8.13,"e":12.12,"text":"A small hand reached up from the cold concrete floor,"},{"s":12.12,"e":15.59,"text":"And Heaven heard the child we chose to ignore."},{"s":15.59,"e":19.58,"text":"Gold gates, cold plates, rain rips through the night,"},{"s":19.58,"e":23.5,"text":"Silk suits, slick truths, city soaked in neon light."},{"s":23.5,"e":27.27,"text":"Glass towers glitter while the gutter waters flow,"},{"s":27.27,"e":31.18,"text":"A mother makes a meal from the crumbs that we throw."},{"s":31.18,"e":34.87,"text":"Big screens beam dreams, bright billboards bloom,"},{"s":34.87,"e":38.79,"text":"A boy blows on blue hands in a crowded waiting room."},{"s":38.79,"e":42.71,"text":"Pulpits preach peace with a polished, perfect grace,"},{"s":42.71,"e":47.31,"text":"Then they pass a mother pleading, can't look her in the face."},{"s":47.31,"e":50.09,"text":"Bread in the bins, beds sitting bare,"},{"s":50.09,"e":54.01,"text":"We had plenty to spare and pretended none was there."},{"s":54.01,"e":57.02,"text":"Built a machine that could mimic a mind,"},{"s":57.02,"e":60.87,"text":"Couldn't muster the meaning of 'leave none behind.'"},{"s":60.87,"e":64.93,"text":"Then the sky split wide, every steeple shook its door,"},{"s":64.93,"e":69.91,"text":"And the Judge asked one question: 'What was all that worship for?'"},{"s":69.91,"e":72.39,"text":"He didn't ask how high we soared,"},{"s":72.39,"e":75.03,"text":"He asked who shivered by our doors."},{"s":75.03,"e":78.87,"text":"The violins fell silent; one silver trumpet roared:"},{"s":78.87,"e":82.79,"text":"'Who did you shelter when the starving needed more?'"},{"s":82.79,"e":87.01,"text":"GOD POINTED AT THE POOR — WHAT WAS ALL YOUR PRAYING FOR?"},{"s":87.01,"e":91.53,"text":"YOU SANG ABOUT MY HEAVEN WHILE THEY SLEPT OUTSIDE YOUR DOOR."},{"s":91.53,"e":95.82,"text":"GOD POINTED AT THE CAGES, AT THE CALVES WE WOULDN'T FREE:"},{"s":95.82,"e":101.09,"text":"'YOU MADE A HELL OF THEIR WHOLE LIVES, THEN ASKED FOR HEAVEN FROM ME.'"},{"s":101.09,"e":105.92,"text":"WHEN THE TRUMPET TORE THE THUNDER, EVERY TOWER SHOOK THE GROUND,"},{"s":105.92,"e":110.21,"text":"EVERY CROWN BECAME A QUESTION, EVERY COIN A HOLLOW SOUND."},{"s":110.21,"e":114.96,"text":"YOU KEPT BEGGING ME FOR HEAVEN, BUILT A HELL BENEATH YOUR FEET;"},{"s":114.96,"e":119.55,"text":"I WAS THERE BESIDE THE STARVING ON YOUR COLD CONCRETE STREET."},{"s":119.55,"e":123.39,"text":"(God pointed at the poor) At the poor, at the poor,"},{"s":123.39,"e":128.06,"text":"(We kept asking Him for more) While they shivered by the door."},{"s":128.06,"e":130.25,"text":"What was all our worship for?"},{"s":130.25,"e":132.06,"text":"God pointed at the poor."},{"s":132.06,"e":135.82,"text":"Steel stalls, still walls, blue fluorescent light,"},{"s":135.82,"e":140.34,"text":"A calf calls for her mother through the middle of the night."},{"s":140.34,"e":144.04,"text":"Pigs press pale noses where the iron bars divide,"},{"s":144.04,"e":148.1,"text":"We made a market out of misery and called it 'supply.'"},{"s":148.1,"e":151.34,"text":"Feathers fall, fans spin, no field, no sky,"},{"s":151.34,"e":155.79,"text":"A bird beats folded wings though she was never free to fly."},{"s":155.79,"e":159.25,"text":"Prices, packages, polished plastic on a plate,"},{"s":159.25,"e":163.02,"text":"We shrink a living lifetime to a label and a date."},{"s":163.02,"e":166.11,"text":"Cold calculations, compassion cast aside,"},{"s":166.11,"e":170.4,"text":"We called it commerce, kept our conscience locked inside."},{"s":170.4,"e":173.57,"text":"No witness, no whisper, no window, no sun,"},{"s":173.57,"e":177.56,"text":"Yet every life is living when the ledger says 'done.'"},{"s":177.56,"e":181.55,"text":"We call the world cruel, shrug shoulders, shut doors,"},{"s":181.55,"e":185.24,"text":"Then ask a God of mercy why He isn't giving more."},{"s":185.24,"e":190.07,"text":"But the trumpet had a tremor, and the heavens held their breath,"},{"s":190.07,"e":195.26,"text":"When He pointed at the pens and asked whose comfort cost their death."},{"s":195.26,"e":197.67,"text":"He didn't ask what we could buy,"},{"s":197.67,"e":200.69,"text":"He asked which cries we'd passed nearby."},{"s":200.69,"e":204.3,"text":"The trumpet cut the clouds; the violins replied:"},{"s":204.3,"e":208.52,"text":"'What kind of love looks right at pain and walks on by?'"},{"s":208.52,"e":212.74,"text":"GOD POINTED AT THE POOR — WHAT WAS ALL YOUR PRAYING FOR?"},{"s":212.74,"e":217.26,"text":"YOU SANG ABOUT MY HEAVEN WHILE THEY SLEPT OUTSIDE YOUR DOOR."},{"s":217.26,"e":221.56,"text":"GOD POINTED AT THE CAGES, AT THE CALVES WE WOULDN'T FREE:"},{"s":221.56,"e":226.83,"text":"'YOU MADE A HELL OF THEIR WHOLE LIVES, THEN ASKED FOR HEAVEN FROM ME.'"},{"s":226.83,"e":229.77,"text":"Where were you when the children cried?"},{"s":229.77,"e":232.55,"text":"We counted coins and closed our eyes."},{"s":232.55,"e":235.79,"text":"Where were you when the creatures screamed?"},{"s":235.79,"e":238.43,"text":"We buried truth beneath our dreams."},{"s":238.43,"e":241.22,"text":"I asked for bread; you offered blame."},{"s":241.22,"e":244.31,"text":"We feared the poor but praised Your name."},{"s":244.31,"e":247.17,"text":"I asked for love; you locked the door."},{"s":247.17,"e":250.11,"text":"And still we prayed for something more."},{"s":250.11,"e":253.2,"text":"All your kings, your courts, your crowns,"},{"s":253.2,"e":255.61,"text":"Couldn't keep the judgment down."},{"s":255.61,"e":257.72,"text":"Not the gold, not the score—"},{"s":257.72,"e":259.52,"text":"God pointed at the poor."},{"s":259.52,"e":263.74,"text":"GOD POINTED AT THE POOR — WHAT WAS ALL YOUR PRAYING FOR?"},{"s":263.74,"e":268.26,"text":"YOU SANG ABOUT MY HEAVEN WHILE THEY SLEPT OUTSIDE YOUR DOOR."},{"s":268.26,"e":272.56,"text":"GOD POINTED AT THE CAGES, AT THE CALVES WE WOULDN'T FREE:"},{"s":272.56,"e":277.83,"text":"'YOU MADE A HELL OF THEIR WHOLE LIVES, THEN ASKED FOR HEAVEN FROM ME.'"},{"s":277.83,"e":282.65,"text":"WHEN THE TRUMPET TORE THE THUNDER, EVERY TOWER SHOOK THE GROUND,"},{"s":282.65,"e":286.95,"text":"EVERY CROWN BECAME A QUESTION, EVERY COIN A HOLLOW SOUND."},{"s":286.95,"e":291.47,"text":"THE GATES OF HELL SWUNG OPEN; WE FELL KNEELING ON THE FLOOR,"},{"s":291.47,"e":296.51,"text":"AND HE ASKED US ONE LAST QUESTION: 'WHAT WAS ALL THAT WORSHIP FOR?'"},{"s":296.51,"e":299.6,"text":"The skies went still; no silver, no gold,"},{"s":299.6,"e":303.44,"text":"Just a child and a calf in the bitter, biting cold."},{"s":303.44,"e":308.19,"text":"One hand pointed toward the lives we'd left outside the door..."},{"s":308.19,"e":310.3,"text":"And God pointed at the poor."}],"duration":310.8,"source":"estimated","generatedAt":null}