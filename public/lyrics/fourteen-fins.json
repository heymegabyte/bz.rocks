w":"kindly,","s":179.3,"e":179.86,"line":62},{"w":"keep","s":179.86,"e":180.19,"line":62},{"w":"courage","s":180.19,"e":180.75,"line":62},{"w":"in","s":180.75,"e":180.91,"line":62},{"w":"view,","s":180.91,"e":181.31,"line":62},{"w":"Ask","s":181.31,"e":181.56,"line":63},{"w":"more","s":181.56,"e":181.88,"line":63},{"w":"questions","s":181.88,"e":182.61,"line":63},{"w":"than","s":182.61,"e":182.93,"line":63},{"w":"the","s":182.93,"e":183.18,"line":63},{"w":"answers","s":183.18,"e":183.74,"line":63},{"w":"you","s":183.74,"e":183.99,"line":63},{"w":"spew.","s":183.99,"e":184.39,"line":63},{"w":"Never","s":184.39,"e":184.78,"line":64},{"w":"humiliate,","s":184.78,"e":185.55,"line":64},{"w":"argue,","s":185.55,"e":186.02,"line":64},{"w":"or","s":186.02,"e":186.17,"line":64},{"w":"accuse—","s":186.17,"e":186.71,"line":64},{"w":"Give","s":186.71,"e":187.03,"line":65},{"w":"them","s":187.03,"e":187.34,"line":65},{"w":"a","s":187.34,"e":187.5,"line":65},{"w":"reason","s":187.5,"e":187.97,"line":65},{"w":"where","s":187.97,"e":188.37,"line":65},{"w":"everybody","s":188.37,"e":189.07,"line":65},{"w":"can","s":189.07,"e":189.31,"line":65},{"w":"choose.","s":189.31,"e":189.86,"line":65},{"w":"Walk","s":189.86,"e":190.19,"line":66},{"w":"through","s":190.19,"e":190.76,"line":66},{"w":"the","s":190.76,"e":191,"line":66},{"w":"water","s":191,"e":191.41,"line":66},{"w":"with","s":191.41,"e":191.74,"line":66},{"w":"wisdom","s":191.74,"e":192.23,"line":66},{"w":"as","s":192.23,"e":192.39,"line":66},{"w":"fuel—","s":192.39,"e":192.8,"line":66},{"w":"That’s","s":192.8,"e":193.28,"line":67},{"w":"how","s":193.28,"e":193.52,"line":67},{"w":"you","s":193.52,"e":193.77,"line":67},{"w":"get","s":193.77,"e":194.01,"line":67},{"w":"out","s":194.01,"e":194.25,"line":67},{"w":"of","s":194.25,"e":194.41,"line":67},{"w":"a","s":194.41,"e":194.57,"line":67},{"w":"shark-filled","s":194.57,"e":195.54,"line":67},{"w":"pool.","s":195.54,"e":195.94,"line":67},{"w":"Fourteen","s":195.94,"e":196.58,"line":68},{"w":"baby","s":196.58,"e":196.9,"line":68},{"w":"sharks","s":196.9,"e":197.37,"line":68},{"w":"let","s":197.37,"e":197.61,"line":68},{"w":"the","s":197.61,"e":197.85,"line":68},{"w":"pathway","s":197.85,"e":198.41,"line":68},{"w":"come","s":198.41,"e":198.72,"line":68},{"w":"through,","s":198.72,"e":199.36,"line":68},{"w":"Not","s":199.36,"e":199.59,"line":69},{"w":"because","s":199.59,"e":200.13,"line":69},{"w":"you","s":200.13,"e":200.36,"line":69},{"w":"crushed","s":200.36,"e":200.9,"line":69},{"w":"them—because","s":200.9,"e":201.83,"line":69},{"w":"connection","s":201.83,"e":202.6,"line":69},{"w":"grew.","s":202.6,"e":202.98,"line":69},{"w":"You","s":202.98,"e":203.23,"line":70},{"w":"can’t","s":203.23,"e":203.63,"line":70},{"w":"always","s":203.63,"e":204.12,"line":70},{"w":"control","s":204.12,"e":204.68,"line":70},{"w":"who","s":204.68,"e":204.93,"line":70},{"w":"is","s":204.93,"e":205.09,"line":70},{"w":"circling","s":205.09,"e":205.74,"line":70},{"w":"you,","s":205.74,"e":206.06,"line":70},{"w":"But","s":206.06,"e":206.31,"line":71},{"w":"you","s":206.31,"e":206.55,"line":71},{"w":"can","s":206.55,"e":206.8,"line":71},{"w":"control","s":206.8,"e":207.37,"line":71},{"w":"what","s":207.37,"e":207.7,"line":71},{"w":"your","s":207.7,"e":208.03,"line":71},{"w":"character","s":208.03,"e":208.77,"line":71},{"w":"will","s":208.77,"e":209.09,"line":71},{"w":"do.","s":209.09,"e":209.34,"line":71}],"lines":[{"s":1.2,"e":3.32,"text":"Fourteen baby sharks in a pool—"},{"s":3.32,"e":5.44,"text":"All circling… whatchu gonna do?"},{"s":5.44,"e":8.38,"text":"Panic makes waves, but patience stays cool—"},{"s":8.38,"e":11.11,"text":"There’s a way out if you know the rules."},{"s":11.11,"e":13.23,"text":"Fourteen baby sharks in a pool,"},{"s":13.23,"e":15.28,"text":"All circling—whatchu gonna do?"},{"s":15.28,"e":18.49,"text":"Don’t splash, don’t clash, don’t play the fool,"},{"s":18.49,"e":21.77,"text":"Win friends, move minds, make respect your tool."},{"s":21.77,"e":24.37,"text":"Fourteen sharp shadows coming for you,"},{"s":24.37,"e":27.38,"text":"But calm conversation can carry you through."},{"s":27.38,"e":30.46,"text":"Find what they want, let ’em feel understood—"},{"s":30.46,"e":33.12,"text":"Turn fourteen foes into a neighborhood."},{"s":33.12,"e":36.06,"text":"First shark charges with a chip on his fin,"},{"s":36.06,"e":38.8,"text":"Don’t criticize—let the listening begin."},{"s":38.8,"e":41.87,"text":"Give honest praise, find the good underneath,"},{"s":41.87,"e":44.95,"text":"A respected shark doesn’t need to show teeth."},{"s":44.95,"e":47.82,"text":"Remember each name like it matters to you,"},{"s":47.82,"e":51.03,"text":"Ask about their ocean, their angle, their view."},{"s":51.03,"e":54.31,"text":"Show genuine interest; don’t fake what you feel—"},{"s":54.31,"e":57.87,"text":"Every heart can detect when the kindness ain’t real."},{"s":57.87,"e":60.87,"text":"Smile in the storm when the water gets wild,"},{"s":60.87,"e":63.88,"text":"Speak with respect, keep your presence mild."},{"s":63.88,"e":67.03,"text":"Let them talk first, let their stories unfold,"},{"s":67.03,"e":70.17,"text":"Attention is treasure more precious than gold."},{"s":70.17,"e":73.38,"text":"You don’t beat the circle by fighting the crew—"},{"s":73.38,"e":77.14,"text":"You open up a channel they can peacefully swim through."},{"s":77.14,"e":79.53,"text":"No sudden motion, no ego explosion,"},{"s":79.53,"e":82.06,"text":"Lead with devotion and level emotion."},{"s":82.06,"e":84.87,"text":"See through their eyes, let empathy rule—"},{"s":84.87,"e":88.01,"text":"That’s how you get out of a shark-filled pool."},{"s":88.01,"e":90.13,"text":"Fourteen baby sharks in a pool,"},{"s":90.13,"e":92.18,"text":"All circling—whatchu gonna do?"},{"s":92.18,"e":95.39,"text":"Don’t splash, don’t clash, don’t play the fool,"},{"s":95.39,"e":98.67,"text":"Win friends, move minds, make respect your tool."},{"s":98.67,"e":101.27,"text":"Fourteen sharp shadows coming for you,"},{"s":101.27,"e":104.28,"text":"But calm conversation can carry you through."},{"s":104.28,"e":107.35,"text":"Find what they want, let ’em feel understood—"},{"s":107.35,"e":110.02,"text":"Turn fourteen foes into a neighborhood."},{"s":110.02,"e":112.96,"text":"If you are wrong, say it quickly and clear—"},{"s":112.96,"e":115.69,"text":"Honest admission makes danger disappear."},{"s":115.69,"e":118.09,"text":"Never begin with a fist or command,"},{"s":118.09,"e":121.03,"text":"Start with agreement, then offer your hand."},{"s":121.03,"e":123.9,"text":"Collect little “yeses,” let momentum grow,"},{"s":123.9,"e":127.25,"text":"Make the right pathway the one they choose to go."},{"s":127.25,"e":130.6,"text":"Don’t claim the whole credit or conquer the room—"},{"s":130.6,"e":133.74,"text":"Let another feel ownership; watch trust bloom."},{"s":133.74,"e":136.61,"text":"Appeal to the noble, the best they can be,"},{"s":136.61,"e":139.41,"text":"Give them a name that inspires integrity."},{"s":139.41,"e":142.28,"text":"Praise every progress, encourage each try,"},{"s":142.28,"e":145.15,"text":"Make faults feel fixable, never magnified."},{"s":145.15,"e":147.68,"text":"Challenge with purpose, not ridicule—"},{"s":147.68,"e":150.55,"text":"Even sharks want dignity deep in the pool."},{"s":150.55,"e":153.36,"text":"One shark: “Why should we let you leave?”"},{"s":153.36,"e":156.37,"text":"“Because I heard what you need and believe.”"},{"s":156.37,"e":159.58,"text":"Two sharks: “Why should we trust what you say?”"},{"s":159.58,"e":162.59,"text":"“Judge by my actions—I’ll show you the way.”"},{"s":162.59,"e":165.18,"text":"Seven on the left, seven on the right:"},{"s":165.18,"e":168.19,"text":"No need for blood when the future is bright."},{"s":168.19,"e":170.99,"text":"Fourteen fins slowly breaking their ring—"},{"s":170.99,"e":173.73,"text":"Respect turned the hunted into the king."},{"s":173.73,"e":175.85,"text":"Fourteen baby sharks in a pool,"},{"s":175.85,"e":178.17,"text":"All circling—now whatchu gonna do?"},{"s":178.17,"e":181.31,"text":"Stay calm, speak kindly, keep courage in view,"},{"s":181.31,"e":184.39,"text":"Ask more questions than the answers you spew."},{"s":184.39,"e":186.71,"text":"Never humiliate, argue, or accuse—"},{"s":186.71,"e":189.86,"text":"Give them a reason where everybody can choose."},{"s":189.86,"e":192.8,"text":"Walk through the water with wisdom as fuel—"},{"s":192.8,"e":195.94,"text":"That’s how you get out of a shark-filled pool."},{"s":195.94,"e":199.36,"text":"Fourteen baby sharks let the pathway come through,"},{"s":199.36,"e":202.98,"text":"Not because you crushed them—because connection grew."},{"s":202.98,"e":206.06,"text":"You can’t always control who is circling you,"},{"s":206.06,"e":209.34,"text":"But you can control what your character will do."}],"duration":209.84,"source":"estimated","generatedAt":null}