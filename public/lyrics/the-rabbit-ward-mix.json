e":30.48,"text":"Says, “Tell me what you saw when the whole world reversed.”"},{"s":30.48,"e":36.06,"text":"Alice bites her tongue till she tastes something red,"},{"s":36.06,"e":38.28,"text":"“There was a rabbit.”"},{"s":38.28,"e":40.91,"text":"He circles what she said."},{"s":40.91,"e":43.54,"text":"“No tunnels. No kingdoms."},{"s":43.54,"e":46.28,"text":"No queen dressed in black."},{"s":46.28,"e":48.6,"text":"No watches, no voices,"},{"s":48.6,"e":51.13,"text":"No looking-glass cracks."},{"s":51.13,"e":53.23,"text":"You want to go home?"},{"s":53.23,"e":55.87,"text":"Then give us the answer.”"},{"s":55.87,"e":57.45,"text":"Alice whispers—"},{"s":57.45,"e":60.5,"text":"“The rabbit is only a rabbit."},{"s":60.5,"e":63.45,"text":"The rabbit is only a rabbit."},{"s":63.45,"e":65.66,"text":"No message inside it,"},{"s":65.66,"e":67.87,"text":"No doorway behind it,"},{"s":67.87,"e":72.72,"text":"No reason on earth I should follow or grab it."},{"s":72.72,"e":75.77,"text":"The rabbit is only a rabbit.”"},{"s":75.77,"e":78.3,"text":"Say it like you mean it."},{"s":78.3,"e":80.62,"text":"Say it till it's true."},{"s":80.62,"e":82.93,"text":"Say it for the doctors"},{"s":82.93,"e":85.36,"text":"Who know more than you."},{"s":85.36,"e":88.52,"text":"“The rabbit is only a rabbit.”"},{"s":88.52,"e":92.2,"text":"And maybe they'll give me my shoes."},{"s":92.2,"e":96.31,"text":"Tuesday tastes exactly like Monday did,"},{"s":96.31,"e":101.37,"text":"She counts ceiling tiles like a good little kid."},{"s":101.37,"e":106.42,"text":"Group room confession underneath buzzing lights:"},{"s":106.42,"e":108.74,"text":"“What is real, Alice?”"},{"s":108.74,"e":112,"text":"She says, “Whatever you write.”"},{"s":112,"e":117.69,"text":"The girl down the hallway says, “Don't fight the tide."},{"s":117.69,"e":122.43,"text":"They don't need you certain, just certified.”"},{"s":122.43,"e":127.59,"text":"Then she taps on the wall—three knocks, then two—"},{"s":127.59,"e":129.91,"text":"Alice hears scratching"},{"s":129.91,"e":131.39,"text":"From Room 302."},{"s":131.39,"e":134.02,"text":"“No tunnels. No kingdoms."},{"s":134.02,"e":136.12,"text":"No tea at half-past."},{"s":136.12,"e":138.97,"text":"The things that you dreamed"},{"s":138.97,"e":141.92,"text":"Are a symptom that's passed."},{"s":141.92,"e":144.66,"text":"You want your own clothes?"},{"s":144.66,"e":147.29,"text":"You want your old habits?"},{"s":147.29,"e":149.29,"text":"Then say it again.”"},{"s":149.29,"e":150.77,"text":"So Alice says—"},{"s":150.77,"e":153.82,"text":"“The rabbit is only a rabbit."},{"s":153.82,"e":156.77,"text":"The rabbit is only a rabbit."},{"s":156.77,"e":159.51,"text":"Its eyes aren't a warning,"},{"s":159.51,"e":162.04,"text":"It doesn't know my name,"},{"s":162.04,"e":165.09,"text":"And clocks don't run backward"},{"s":165.09,"e":167.2,"text":"No matter the panic."},{"s":167.2,"e":170.25,"text":"The rabbit is only a rabbit.”"},{"s":170.25,"e":172.46,"text":"I know how to say it."},{"s":172.46,"e":174.78,"text":"I'm learning the tune."},{"s":174.78,"e":176.78,"text":"Morning medication,"},{"s":176.78,"e":178.36,"text":"Dinner at noon."},{"s":178.36,"e":181.52,"text":"“The rabbit is only a rabbit.”"},{"s":181.52,"e":185.21,"text":"Now please let me out of this room."},{"s":185.21,"e":186.79,"text":"Rabbit, rabbit—"},{"s":186.79,"e":188.37,"text":"Nothing to see."},{"s":188.37,"e":189.95,"text":"Rabbit, rabbit—"},{"s":189.95,"e":191.53,"text":"Nothing but me."},{"s":191.53,"e":193.11,"text":"Rabbit, rabbit—"},{"s":193.11,"e":194.9,"text":"Four little feet."},{"s":194.9,"e":197.32,"text":"Then why do I hear them"},{"s":197.32,"e":199.32,"text":"Running underneath?"},{"s":199.32,"e":204.27,"text":"Her mother comes Sunday with tears in her eyes,"},{"s":204.27,"e":209.33,"text":"Says, “Baby, just tell them whatever they like.”"},{"s":209.33,"e":214.91,"text":"Alice says, “What if pretending is part of the trap?”"},{"s":214.91,"e":217.86,"text":"Her mother squeezes tighter:"},{"s":217.86,"e":220.49,"text":"“Just get yourself back.”"},{"s":220.49,"e":222.18,"text":"But which Alice?"},{"s":222.18,"e":224.6,"text":"The one before falling?"},{"s":224.6,"e":226.71,"text":"The one after pills?"},{"s":226.71,"e":229.87,"text":"The one who stopped screaming?"},{"s":229.87,"e":232.18,"text":"The one sitting still?"},{"s":232.18,"e":234.5,"text":"If sanity's a password"},{"s":234.5,"e":236.4,"text":"Printed on a page,"},{"s":236.4,"e":238.71,"text":"Is freedom being free—"},{"s":238.71,"e":241.35,"text":"Or saying the right thing"},{"s":241.35,"e":244.09,"text":"To whoever holds the cage?"},{"s":244.09,"e":249.25,"text":"So Alice stands straight when the doctors arrive."},{"s":249.25,"e":251.35,"text":"Hair neatly brushed."},{"s":251.35,"e":252.62,"text":"Voice quiet."},{"s":252.62,"e":253.57,"text":"Eyes dry."},{"s":253.57,"e":256.09,"text":"“Do you understand now?”"},{"s":256.09,"e":257.25,"text":"She smiles."},{"s":257.25,"e":258.09,"text":"“I do.”"},{"s":258.09,"e":260.41,"text":"“What was the rabbit?”"},{"s":260.41,"e":261.57,"text":"“A rabbit.”"},{"s":261.57,"e":263.15,"text":"“Nothing more?”"},{"s":263.15,"e":264.73,"text":"“Nothing more.”"},{"s":264.73,"e":267.05,"text":"The pen makes a check."},{"s":267.05,"e":269.47,"text":"The lock makes a sound."},{"s":269.47,"e":272.1,"text":"And somewhere inside her,"},{"s":272.1,"e":274.95,"text":"Something goes underground."},{"s":274.95,"e":278,"text":"“The rabbit is only a rabbit."},{"s":278,"e":280.95,"text":"The rabbit is only a rabbit."},{"s":280.95,"e":283.06,"text":"No prophecy, portal,"},{"s":283.06,"e":285.27,"text":"No beautiful madness,"},{"s":285.27,"e":289.48,"text":"No universe hiding inside of the static."},{"s":289.48,"e":292.54,"text":"The rabbit is only a rabbit.”"},{"s":292.54,"e":294.64,"text":"I said it correctly."},{"s":294.64,"e":296.75,"text":"You opened the door."},{"s":296.75,"e":299.28,"text":"You gave back my jacket,"},{"s":299.28,"e":301.59,"text":"My name, and my phone."},{"s":301.59,"e":304.54,"text":"The rabbit is only a rabbit."},{"s":304.54,"e":307.7,"text":"I don't chase rabbits anymore."},{"s":307.7,"e":310.34,"text":"She walks past reception."},{"s":310.34,"e":312.44,"text":"Past security glass."},{"s":312.44,"e":314.87,"text":"Past the sign that says"},{"s":314.87,"e":317.08,"text":"RECOVERY IS POSSIBLE."},{"s":317.08,"e":317.92,"text":"Outside—"},{"s":317.92,"e":319.18,"text":"October air."},{"s":319.18,"e":320.03,"text":"Cars."},{"s":320.03,"e":320.87,"text":"People."},{"s":320.87,"e":322.66,"text":"Ordinary morning."},{"s":322.66,"e":324.98,"text":"Alice closes her eyes."},{"s":324.98,"e":325.93,"text":"Breathes."},{"s":325.93,"e":327.08,"text":"Opens them."},{"s":327.08,"e":329.51,"text":"Across the parking lot,"},{"s":329.51,"e":331.09,"text":"Something white"},{"s":331.09,"e":333.19,"text":"slips behind a tree."},{"s":333.19,"e":334.67,"text":"Two long ears."},{"s":334.67,"e":335.72,"text":"A flicker."},{"s":335.72,"e":336.56,"text":"Gone."},{"s":336.56,"e":338.78,"text":"Alice doesn't follow."},{"s":338.78,"e":340.99,"text":"She smiles to herself"},{"s":340.99,"e":342.36,"text":"and whispers:"},{"s":342.36,"e":345.52,"text":"“The rabbit is only a rabbit.”"},{"s":345.52,"e":348.04,"text":"Three steps toward home."},{"s":348.04,"e":350.47,"text":"Then, under her breath—"},{"s":350.47,"e":352.78,"text":"“But nobody ever asked"},{"s":352.78,"e":356.26,"text":"what the rabbit thinks of Alice.”"}],"duration":356.76,"source":"estimated","generatedAt":null}