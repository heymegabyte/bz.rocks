":215.38,"e":215.94,"line":75},{"w":"day—get","s":215.94,"e":216.72,"line":75},{"w":"up,","s":216.72,"e":217.06,"line":75},{"w":"go","s":217.06,"e":217.28,"line":75},{"w":"again!","s":217.28,"e":217.95,"line":75},{"w":"Knock","s":217.95,"e":218.52,"line":76},{"w":"me","s":218.52,"e":218.74,"line":76},{"w":"down","s":218.74,"e":219.19,"line":76},{"w":"nine,","s":219.19,"e":219.76,"line":76},{"w":"I","s":219.76,"e":219.99,"line":76},{"w":"rise","s":219.99,"e":220.44,"line":76},{"w":"up","s":220.44,"e":220.67,"line":76},{"w":"TEN!","s":220.67,"e":221.12,"line":76},{"w":"WIN,","s":221.12,"e":221.56,"line":77},{"w":"WIN,","s":221.56,"e":222.01,"line":77},{"w":"WIN—put","s":222.01,"e":222.79,"line":77},{"w":"the","s":222.79,"e":223.12,"line":77},{"w":"work","s":223.12,"e":223.57,"line":77},{"w":"on","s":223.57,"e":223.79,"line":77},{"w":"replay!","s":223.79,"e":224.57,"line":77},{"w":"Gold","s":224.57,"e":225.04,"line":78},{"w":"in","s":225.04,"e":225.27,"line":78},{"w":"my","s":225.27,"e":225.51,"line":78},{"w":"blood,","s":225.51,"e":226.22,"line":78},{"w":"got","s":226.22,"e":226.57,"line":78},{"w":"the","s":226.57,"e":226.92,"line":78},{"w":"grit","s":226.92,"e":227.39,"line":78},{"w":"in","s":227.39,"e":227.63,"line":78},{"w":"my","s":227.63,"e":227.87,"line":78},{"w":"veins!","s":227.87,"e":228.57,"line":78},{"w":"All","s":228.57,"e":228.91,"line":79},{"w":"day,","s":228.91,"e":229.35,"line":79},{"w":"every","s":229.35,"e":229.9,"line":79},{"w":"day—hear","s":229.9,"e":230.79,"line":79},{"w":"the","s":230.79,"e":231.12,"line":79},{"w":"whole","s":231.12,"e":231.68,"line":79},{"w":"crowd","s":231.68,"e":232.23,"line":79},{"w":"say:","s":232.23,"e":232.67,"line":79},{"w":"CAN’T","s":232.67,"e":233.24,"line":80},{"w":"TAKE","s":233.24,"e":233.7,"line":80},{"w":"MY","s":233.7,"e":233.92,"line":80},{"w":"FIRE!","s":233.92,"e":234.49,"line":80},{"w":"CAN’T","s":234.49,"e":235.06,"line":80},{"w":"TAKE","s":235.06,"e":235.51,"line":80},{"w":"MY","s":235.51,"e":235.74,"line":80},{"w":"NAME!","s":235.74,"e":236.31,"line":80},{"w":"All","s":236.31,"e":236.63,"line":81},{"w":"day!","s":236.63,"e":237.05,"line":81},{"w":"Every","s":237.05,"e":237.57,"line":82},{"w":"day!","s":237.57,"e":237.98,"line":82},{"w":"COUNT","s":237.98,"e":238.54,"line":83},{"w":"ME","s":238.54,"e":238.76,"line":83},{"w":"OUT—","s":238.76,"e":239.2,"line":83},{"w":"COUNT","s":239.2,"e":239.7,"line":84},{"w":"AGAIN!","s":239.7,"e":240.31,"line":84},{"w":"WIN.","s":240.31,"e":241.06,"line":85}],"lines":[{"s":1.2,"e":1.95,"text":"Win."},{"s":1.95,"e":2.69,"text":"Win."},{"s":2.69,"e":3.44,"text":"Win."},{"s":3.44,"e":5.95,"text":"You thought I was finished?"},{"s":5.95,"e":7.91,"text":"That was the warm-up."},{"s":7.91,"e":8.75,"text":"Hands up."},{"s":8.75,"e":9.68,"text":"Chin high."},{"s":9.68,"e":10.7,"text":"Still here."},{"s":10.7,"e":11.73,"text":"Still mine."},{"s":11.73,"e":12.76,"text":"One breath."},{"s":12.76,"e":13.59,"text":"One life."},{"s":13.59,"e":14.53,"text":"Now watch—"},{"s":14.53,"e":15.74,"text":"IT’S MY TIME."},{"s":15.74,"e":19.46,"text":"WIN, WIN, WIN—let the whole place shake!"},{"s":19.46,"e":22.91,"text":"CHAMPION HEART that you can’t unmake!"},{"s":22.91,"e":26.27,"text":"All day, every day—get up, go again!"},{"s":26.27,"e":29.44,"text":"Knock me down nine, I rise up TEN!"},{"s":29.44,"e":32.88,"text":"WIN, WIN, WIN—put the work on replay!"},{"s":32.88,"e":36.89,"text":"Gold in my blood, got the grit in my veins!"},{"s":36.89,"e":40.99,"text":"All day, every day—hear the whole crowd say:"},{"s":40.99,"e":44.62,"text":"CAN’T TAKE MY FIRE! CAN’T TAKE MY NAME!"},{"s":44.62,"e":48.72,"text":"Cold floor, six-four-five, shoes by the bed,"},{"s":48.72,"e":52.64,"text":"Old losses still talking, new miles ahead."},{"s":52.64,"e":56.09,"text":"No crowd, no camera, no hand to hold,"},{"s":56.09,"e":60,"text":"Just a heartbeat hammering, “Go get gold.”"},{"s":60,"e":63.45,"text":"Paid my dues in the dark, no receipt,"},{"s":63.45,"e":67.92,"text":"Made a drum out the doubt, put it under my feet."},{"s":67.92,"e":71.65,"text":"Every “not yet” put a notch in my spine,"},{"s":71.65,"e":76.77,"text":"Now the clock hits pressure and the pressure hits mine."},{"s":76.77,"e":80.69,"text":"Ain’t none of you hags gonna spell me out,"},{"s":80.69,"e":84.51,"text":"I break that hex when the bass gets loud."},{"s":84.51,"e":87.86,"text":"Throw shade—watch the roots go deep;"},{"s":87.86,"e":92.06,"text":"I was growing while you thought I was asleep."},{"s":92.06,"e":94.85,"text":"I don’t need the road to bend,"},{"s":94.85,"e":97.55,"text":"I don’t need the pain to end."},{"s":97.55,"e":100.63,"text":"Give me one more breath and then—"},{"s":100.63,"e":101.47,"text":"I GET UP."},{"s":101.47,"e":102.49,"text":"I GO AGAIN."},{"s":102.49,"e":106.22,"text":"WIN, WIN, WIN—let the whole place shake!"},{"s":106.22,"e":109.67,"text":"CHAMPION HEART that you can’t unmake!"},{"s":109.67,"e":113.02,"text":"All day, every day—get up, go again!"},{"s":113.02,"e":116.19,"text":"Knock me down nine, I rise up TEN!"},{"s":116.19,"e":119.64,"text":"WIN, WIN, WIN—put the work on replay!"},{"s":119.64,"e":123.65,"text":"Gold in my blood, got the grit in my veins!"},{"s":123.65,"e":127.75,"text":"All day, every day—hear the whole crowd say:"},{"s":127.75,"e":131.38,"text":"CAN’T TAKE MY FIRE! CAN’T TAKE MY NAME!"},{"s":131.38,"e":135.01,"text":"Hear that hush when I step on the line?"},{"s":135.01,"e":139.67,"text":"That’s a thousand bad nights getting paid on time."},{"s":139.67,"e":143.77,"text":"Scuffed-up soles and a shirt soaked through—"},{"s":143.77,"e":148.34,"text":"I brought every last loss to the win with me too."},{"s":148.34,"e":152.25,"text":"Fear, I’ll break you down, brick by brick,"},{"s":152.25,"e":155.8,"text":"Build my next step out of every trick."},{"s":155.8,"e":159.71,"text":"Here’s your prophecy: remember this sound—"},{"s":159.71,"e":163.72,"text":"What tried to bury me is holding me up now."},{"s":163.72,"e":166.88,"text":"No borrowed crown, no rented roar,"},{"s":166.88,"e":170.24,"text":"I left my excuses outside that door."},{"s":170.24,"e":173.78,"text":"Last lap, lungs burn, legs say “done”—"},{"s":173.78,"e":178.25,"text":"Heart says, “We haven’t met the best part, son.”"},{"s":178.25,"e":179.37,"text":"If you ever…"},{"s":179.37,"e":180.49,"text":"If you EVER…"},{"s":180.49,"e":181.7,"text":"COUNT ME OUT—"},{"s":181.7,"e":182.82,"text":"COUNT AGAIN!"},{"s":182.82,"e":184.03,"text":"COUNT ME OUT—"},{"s":184.03,"e":185.15,"text":"COUNT AGAIN!"},{"s":185.15,"e":188.78,"text":"One more step when the hill gets steep."},{"s":188.78,"e":192.04,"text":"One more dream that we get to keep."},{"s":192.04,"e":195.68,"text":"One more voice till the walls give way."},{"s":195.68,"e":197.26,"text":"We rise together."},{"s":197.26,"e":198.47,"text":"We win today."},{"s":198.47,"e":200.8,"text":"Not because I never fell—"},{"s":200.8,"e":202.85,"text":"BECAUSE I GOT BACK UP!"},{"s":202.85,"e":205.37,"text":"Not because it didn’t hurt—"},{"s":205.37,"e":207.42,"text":"BECAUSE I DIDN’T STOP!"},{"s":207.42,"e":211.15,"text":"WIN, WIN, WIN—let the whole place shake!"},{"s":211.15,"e":214.6,"text":"CHAMPION HEART that you can’t unmake!"},{"s":214.6,"e":217.95,"text":"All day, every day—get up, go again!"},{"s":217.95,"e":221.12,"text":"Knock me down nine, I rise up TEN!"},{"s":221.12,"e":224.57,"text":"WIN, WIN, WIN—put the work on replay!"},{"s":224.57,"e":228.57,"text":"Gold in my blood, got the grit in my veins!"},{"s":228.57,"e":232.67,"text":"All day, every day—hear the whole crowd say:"},{"s":232.67,"e":236.31,"text":"CAN’T TAKE MY FIRE! CAN’T TAKE MY NAME!"},{"s":236.31,"e":237.05,"text":"All day!"},{"s":237.05,"e":237.98,"text":"Every day!"},{"s":237.98,"e":239.2,"text":"COUNT ME OUT—"},{"s":239.2,"e":240.31,"text":"COUNT AGAIN!"},{"s":240.31,"e":241.06,"text":"WIN."}],"duration":241.56,"source":"estimated","generatedAt":null}