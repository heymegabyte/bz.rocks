,"e":192.71,"line":47},{"w":"light","s":192.71,"e":193.27,"line":47},{"w":"lead","s":193.27,"e":193.72,"line":47},{"w":"the","s":193.72,"e":194.06,"line":47},{"w":"way:","s":194.06,"e":194.51,"line":47},{"w":"facts","s":194.51,"e":195.07,"line":47},{"w":"before","s":195.07,"e":195.75,"line":47},{"w":"fear.","s":195.75,"e":196.31,"line":47},{"w":"Facts","s":196.31,"e":196.85,"line":48},{"w":"before","s":196.85,"e":197.5,"line":48},{"w":"fear,","s":197.5,"e":198.04,"line":48},{"w":"breath","s":198.04,"e":198.69,"line":48},{"w":"by","s":198.69,"e":198.91,"line":48},{"w":"breath,","s":198.91,"e":199.67,"line":48},{"w":"A","s":199.67,"e":199.88,"line":49},{"w":"thought","s":199.88,"e":200.63,"line":49},{"w":"isn’t","s":200.63,"e":201.16,"line":49},{"w":"fate","s":201.16,"e":201.59,"line":49},{"w":"and","s":201.59,"e":201.91,"line":49},{"w":"a","s":201.91,"e":202.12,"line":49},{"w":"feeling’s","s":202.12,"e":203.08,"line":49},{"w":"not","s":203.08,"e":203.4,"line":49},{"w":"death.","s":203.4,"e":204.04,"line":49},{"w":"I’ll","s":204.04,"e":204.48,"line":50},{"w":"be","s":204.48,"e":204.7,"line":50},{"w":"gentle,","s":204.7,"e":205.47,"line":50},{"w":"be","s":205.47,"e":205.69,"line":50},{"w":"grounded,","s":205.69,"e":206.67,"line":50},{"w":"be","s":206.67,"e":206.89,"line":50},{"w":"boldly","s":206.89,"e":207.55,"line":50},{"w":"sincere—","s":207.55,"e":208.42,"line":50},{"w":"I","s":208.42,"e":208.64,"line":51},{"w":"am","s":208.64,"e":208.86,"line":51},{"w":"here.","s":208.86,"e":209.4,"line":51},{"w":"I","s":209.4,"e":209.62,"line":51},{"w":"am","s":209.62,"e":209.84,"line":51},{"w":"clear.","s":209.84,"e":210.49,"line":51},{"w":"Facts","s":210.49,"e":211.04,"line":51},{"w":"before","s":211.04,"e":211.69,"line":51},{"w":"fear.","s":211.69,"e":212.24,"line":51},{"w":"What","s":212.24,"e":212.64,"line":52},{"w":"happened?","s":212.64,"e":213.54,"line":52},{"w":"What’s","s":213.54,"e":214.15,"line":53},{"w":"known?","s":214.15,"e":214.75,"line":53},{"w":"What","s":214.75,"e":215.19,"line":54},{"w":"choice","s":215.19,"e":215.85,"line":54},{"w":"brings","s":215.85,"e":216.51,"line":54},{"w":"me","s":216.51,"e":216.74,"line":54},{"w":"near","s":216.74,"e":217.18,"line":54},{"w":"To","s":217.18,"e":217.4,"line":55},{"w":"the","s":217.4,"e":217.73,"line":55},{"w":"life","s":217.73,"e":218.17,"line":55},{"w":"I’m","s":218.17,"e":218.51,"line":55},{"w":"creating?","s":218.51,"e":219.5,"line":55},{"w":"Facts","s":219.5,"e":220.03,"line":56},{"w":"before","s":220.03,"e":220.66,"line":56},{"w":"fear.","s":220.66,"e":221.18,"line":56}],"lines":[{"s":1.2,"e":5.76,"text":"Fear hit the phone, said, “Something went wrong.”"},{"s":5.76,"e":11.35,"text":"Facts checked the line—said, “You don’t know that, hold on.”"},{"s":11.35,"e":15.82,"text":"One thought caught fire, tried to burn all year—"},{"s":15.82,"e":20.76,"text":"But I won’t feed fiction; I choose facts before fear."},{"s":20.76,"e":24.95,"text":"My mind makes a movie from a moment of doubt,"},{"s":24.95,"e":29.61,"text":"Writes the worst ending before truth can come out."},{"s":29.61,"e":33.7,"text":"A silence feels final, a delay feels severe,"},{"s":33.7,"e":38.08,"text":"But feelings aren’t facts—I need evidence here."},{"s":38.08,"e":42.83,"text":"What happened? What’s known? What story did I spin?"},{"s":42.83,"e":47.11,"text":"Is this danger at the door, or an echo within?"},{"s":47.11,"e":52.24,"text":"I can soften my shoulders, let my breathing grow clear;"},{"s":52.24,"e":56.71,"text":"I don’t have to obey every thought that appears."},{"s":56.71,"e":60.53,"text":"Stop. Step back. Let the storm move past."},{"s":60.53,"e":64.72,"text":"Observe what is real—not the shadow it casts."},{"s":64.72,"e":69.09,"text":"Proceed with intention; let my wise mind steer—"},{"s":69.09,"e":73.38,"text":"Put the proof on the table: facts before fear."},{"s":73.38,"e":76.92,"text":"Facts before fear, truth before tears,"},{"s":76.92,"e":81.11,"text":"I won’t make one minute predict all my years."},{"s":81.11,"e":85.76,"text":"I can feel what I feel without shifting the gears—"},{"s":85.76,"e":90.05,"text":"Let the wave rise and fall: facts before fear."},{"s":90.05,"e":93.4,"text":"Facts before fear, breath by breath,"},{"s":93.4,"e":97.78,"text":"A thought isn’t fate and a feeling’s not death."},{"s":97.78,"e":102.34,"text":"If the evidence changes, I’ll change how I steer—"},{"s":102.34,"e":106.35,"text":"But until truth arrives: facts before fear."},{"s":106.35,"e":110.63,"text":"Mind went missing, made a myth from a message,"},{"s":110.63,"e":115.94,"text":"Turned a pause to a problem, put my peace under pressure."},{"s":115.94,"e":120.5,"text":"Now I check the context, collect the connections,"},{"s":120.5,"e":124.51,"text":"Separate assumptions from actual detection."},{"s":124.51,"e":129.54,"text":"“What supports this thought? What disputes this view?”"},{"s":129.54,"e":134.19,"text":"“What would I say if my best friend came through?”"},{"s":134.19,"e":138.29,"text":"Maybe they’re busy; maybe nothing is broken,"},{"s":138.29,"e":142.76,"text":"Maybe silence is silence—not rejection unspoken."},{"s":142.76,"e":147.14,"text":"Name the distortion: mind-reading, all-or-none,"},{"s":147.14,"e":151.42,"text":"Catastrophe collapsing every cloud on the sun."},{"s":151.42,"e":156.73,"text":"I can check all the facts, choose an action that’s clear,"},{"s":156.73,"e":161.3,"text":"Make room for emotion—but don’t crown it as seer."},{"s":161.3,"e":162.97,"text":"I am not my alarm."},{"s":162.97,"e":165.3,"text":"I am safe in this breath."},{"s":165.3,"e":167.72,"text":"I can tolerate uncertainty"},{"s":167.72,"e":170.14,"text":"Without rehearsing regret."},{"s":170.14,"e":172.66,"text":"Acceptance isn’t surrender;"},{"s":172.66,"e":174.89,"text":"It’s seeing what’s here."},{"s":174.89,"e":177.31,"text":"Then choosing my next move"},{"s":177.31,"e":179.55,"text":"From my values—not fear."},{"s":179.55,"e":183.09,"text":"FACTS BEFORE FEAR, truth before tears,"},{"s":183.09,"e":187.56,"text":"I survived every storm that once sounded severe."},{"s":187.56,"e":192.03,"text":"I can honor my heart while my wise mind appears—"},{"s":192.03,"e":196.31,"text":"Let the light lead the way: facts before fear."},{"s":196.31,"e":199.67,"text":"Facts before fear, breath by breath,"},{"s":199.67,"e":204.04,"text":"A thought isn’t fate and a feeling’s not death."},{"s":204.04,"e":208.42,"text":"I’ll be gentle, be grounded, be boldly sincere—"},{"s":208.42,"e":212.24,"text":"I am here. I am clear. Facts before fear."},{"s":212.24,"e":213.54,"text":"What happened?"},{"s":213.54,"e":214.75,"text":"What’s known?"},{"s":214.75,"e":217.18,"text":"What choice brings me near"},{"s":217.18,"e":219.5,"text":"To the life I’m creating?"},{"s":219.5,"e":221.18,"text":"Facts before fear."}],"duration":221.68,"source":"estimated","generatedAt":null}