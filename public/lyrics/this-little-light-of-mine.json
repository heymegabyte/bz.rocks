"line":116},{"w":"IT","s":286.37,"e":286.58,"line":116},{"w":"SHINE!","s":286.58,"e":287.19,"line":116},{"w":"LET","s":287.19,"e":287.5,"line":116},{"w":"IT","s":287.5,"e":287.71,"line":116},{"w":"SHINE!","s":287.71,"e":288.32,"line":116},{"w":"LET","s":288.32,"e":288.61,"line":117},{"w":"EVERY","s":288.61,"e":289.1,"line":117},{"w":"HEART","s":289.1,"e":289.58,"line":117},{"w":"ALIGN!","s":289.58,"e":290.16,"line":117},{"w":"MAY","s":290.16,"e":290.46,"line":118},{"w":"THE","s":290.46,"e":290.75,"line":118},{"w":"BLESSINGS","s":290.75,"e":291.63,"line":118},{"w":"KEEP","s":291.63,"e":292.02,"line":118},{"w":"ON","s":292.02,"e":292.22,"line":118},{"w":"BLOOMING","s":292.22,"e":293,"line":118},{"w":"THROUGH","s":293,"e":293.68,"line":119},{"w":"ALL","s":293.68,"e":293.97,"line":119},{"w":"PEOPLE,","s":293.97,"e":294.65,"line":119},{"w":"SPACE,","s":294.65,"e":295.24,"line":119},{"w":"AND","s":295.24,"e":295.53,"line":119},{"w":"TIME!","s":295.53,"e":296.01,"line":119},{"w":"Blessings","s":296.01,"e":296.87,"line":120},{"w":"on","s":296.87,"e":297.06,"line":120},{"w":"the","s":297.06,"e":297.35,"line":120},{"w":"babies!","s":297.35,"e":298.02,"line":120},{"w":"Blessings","s":298.02,"e":298.88,"line":121},{"w":"on","s":298.88,"e":299.08,"line":121},{"w":"the","s":299.08,"e":299.36,"line":121},{"w":"brave!","s":299.36,"e":299.94,"line":121},{"w":"Blessings","s":299.94,"e":300.8,"line":122},{"w":"on","s":300.8,"e":300.99,"line":122},{"w":"the","s":300.99,"e":301.28,"line":122},{"w":"living!","s":301.28,"e":301.95,"line":122},{"w":"Love","s":301.95,"e":302.33,"line":123},{"w":"beyond","s":302.33,"e":302.91,"line":123},{"w":"the","s":302.91,"e":303.21,"line":123},{"w":"grave!","s":303.21,"e":303.79,"line":123},{"w":"Blessings","s":303.79,"e":304.64,"line":124},{"w":"for","s":304.64,"e":304.93,"line":124},{"w":"the","s":304.93,"e":305.21,"line":124},{"w":"future!","s":305.21,"e":305.88,"line":124},{"w":"Mercy","s":305.88,"e":306.37,"line":125},{"w":"for","s":306.37,"e":306.67,"line":125},{"w":"the","s":306.67,"e":306.97,"line":125},{"w":"past!","s":306.97,"e":307.46,"line":125},{"w":"LET","s":307.46,"e":307.77,"line":126},{"w":"THE","s":307.77,"e":308.08,"line":126},{"w":"LOVE","s":308.08,"e":308.5,"line":126},{"w":"WE","s":308.5,"e":308.71,"line":126},{"w":"GIVE","s":308.71,"e":309.12,"line":126},{"w":"TODAY","s":309.12,"e":309.64,"line":126},{"w":"BE","s":309.64,"e":309.84,"line":127},{"w":"THE","s":309.84,"e":310.14,"line":127},{"w":"LOVE","s":310.14,"e":310.54,"line":127},{"w":"THAT","s":310.54,"e":310.94,"line":127},{"w":"ALWAYS","s":310.94,"e":311.54,"line":127},{"w":"LASTS!","s":311.54,"e":312.14,"line":127},{"w":"LET","s":312.14,"e":312.42,"line":128},{"w":"IT","s":312.42,"e":312.61,"line":128},{"w":"SHIIIIIIIIINE!","s":312.61,"e":313.9,"line":128}],"lines":[{"s":1.2,"e":4.63,"text":"One Light. Every Life. Everybody Blessed."},{"s":4.63,"e":6.97,"text":"This little light of mine..."},{"s":6.97,"e":9.06,"text":"I'm gonna let it shine..."},{"s":9.06,"e":11.65,"text":"For every heart that's hurting,"},{"s":11.65,"e":13.82,"text":"For every soul that cries,"},{"s":13.82,"e":16.25,"text":"May a million little miracles"},{"s":16.25,"e":18.67,"text":"Light a million little skies."},{"s":18.67,"e":21.18,"text":"Nobody left outside the light."},{"s":21.18,"e":23.6,"text":"May the weary wake to wonder,"},{"s":23.6,"e":26.28,"text":"May the broken breathe in peace,"},{"s":26.28,"e":29.03,"text":"May the frightened find a family,"},{"s":29.03,"e":31.63,"text":"May the fighting finally cease."},{"s":31.63,"e":34.22,"text":"May the mother find her moment,"},{"s":34.22,"e":36.56,"text":"May the father find his way,"},{"s":36.56,"e":39.32,"text":"May the children sleep in safety,"},{"s":39.32,"e":41.41,"text":"May tomorrow bless today."},{"s":41.41,"e":44.25,"text":"May the lonely know they're loved,"},{"s":44.25,"e":47.01,"text":"May the lost find somewhere kind,"},{"s":47.01,"e":49.6,"text":"May the ones who feel forgotten"},{"s":49.6,"e":52.44,"text":"Find a hand that holds them tight."},{"s":52.44,"e":55.28,"text":"If you've never felt the sunshine,"},{"s":55.28,"e":57.79,"text":"If you've only known the rain,"},{"s":57.79,"e":59.96,"text":"Take a little of my light,"},{"s":59.96,"e":62.72,"text":"Let it love you through the pain."},{"s":62.72,"e":64.39,"text":"One for the hurting!"},{"s":64.39,"e":65.98,"text":"One for the healed!"},{"s":65.98,"e":69.32,"text":"One for the hearts that refuse to yield!"},{"s":69.32,"e":71.08,"text":"One for the stranger!"},{"s":71.08,"e":72.67,"text":"One for the friend!"},{"s":72.67,"e":76.34,"text":"LOVE IS THE LIGHT THAT WE NEVER HAVE TO END!"},{"s":76.34,"e":78.52,"text":"THIS LITTLE LIGHT OF MINE!"},{"s":78.52,"e":80.44,"text":"I'M GONNA LET IT SHINE!"},{"s":80.44,"e":82.86,"text":"Let it shine on every nation,"},{"s":82.86,"e":85.12,"text":"Every neighbor, every life!"},{"s":85.12,"e":87.38,"text":"LET IT SHINE, SHINE, SHINE!"},{"s":87.38,"e":89.38,"text":"LET IT RISE, RISE, RISE!"},{"s":89.38,"e":92.14,"text":"May the blessing keep on blooming"},{"s":92.14,"e":94.82,"text":"Till it fills the endless skies!"},{"s":94.82,"e":96.32,"text":"NO SOUL TOO SMALL!"},{"s":96.32,"e":97.91,"text":"NO ONE LEFT BEHIND!"},{"s":97.91,"e":99.58,"text":"ONE LOVE! ONE WORLD!"},{"s":99.58,"e":102.01,"text":"LET EVERY LITTLE LIGHT SHINE!"},{"s":102.01,"e":104.85,"text":"Bless the babies, bless the brave,"},{"s":104.85,"e":107.27,"text":"Bless the broken being saved,"},{"s":107.27,"e":110.2,"text":"Bless the workers working weekends,"},{"s":110.2,"e":113.21,"text":"Bless the hands that dig the graves."},{"s":113.21,"e":116.47,"text":"Bless the cooks and bless the cleaners,"},{"s":116.47,"e":119.23,"text":"Bless the dreamers drawing plans,"},{"s":119.23,"e":122.4,"text":"Bless the patient, bless the prisoner,"},{"s":122.4,"e":125.16,"text":"Bless the trembling, tired hands."},{"s":125.16,"e":128.17,"text":"Bless the homeless, hungry, hurting,"},{"s":128.17,"e":130.59,"text":"Bless the hopeful holding on,"},{"s":130.59,"e":133.18,"text":"Bless the people picking pieces"},{"s":133.18,"e":135.52,"text":"Up before the break of dawn."},{"s":135.52,"e":138.12,"text":"May the poor possess abundance,"},{"s":138.12,"e":140.79,"text":"May the powerful practice grace,"},{"s":140.79,"e":143.47,"text":"May the weary win their freedom,"},{"s":143.47,"e":145.81,"text":"May compassion conquer hate."},{"s":145.81,"e":148.15,"text":"Bless the ones who disagree,"},{"s":148.15,"e":150.65,"text":"Bless the ones who doubted me,"},{"s":150.65,"e":153.5,"text":"Bless the ones who lost their way,"},{"s":153.5,"e":155.42,"text":"May they find serenity."},{"s":155.42,"e":157.76,"text":"Every border, every borough,"},{"s":157.76,"e":160.1,"text":"Every village, every street,"},{"s":160.1,"e":162.77,"text":"May the stranger find a shelter,"},{"s":162.77,"e":165.11,"text":"May the hungry find a feast."},{"s":165.11,"e":167.62,"text":"No more measuring who matters,"},{"s":167.62,"e":169.96,"text":"No more ranking human worth,"},{"s":169.96,"e":172.55,"text":"Every heartbeat holds a heaven,"},{"s":172.55,"e":175.15,"text":"Every child deserves the Earth!"},{"s":175.15,"e":177.57,"text":"What if love was overflowing?"},{"s":177.57,"e":179.66,"text":"What if mercy multiplied?"},{"s":179.66,"e":182.17,"text":"What if every soul was glowing"},{"s":182.17,"e":184.84,"text":"With a light they couldn't hide?"},{"s":184.84,"e":187.52,"text":"Then we'd give it to each other!"},{"s":187.52,"e":189.69,"text":"Let the blessing multiply!"},{"s":189.69,"e":192.11,"text":"ONE FLAME CAN LIGHT A MILLION"},{"s":192.11,"e":194.54,"text":"WITHOUT LOSING ITS OWN SHINE!"},{"s":194.54,"e":196.71,"text":"THIS LITTLE LIGHT OF MINE!"},{"s":196.71,"e":198.63,"text":"I'M GONNA LET IT SHINE!"},{"s":198.63,"e":201.22,"text":"Let it shine across the oceans,"},{"s":201.22,"e":204.4,"text":"Past the mountains, through the night!"},{"s":204.4,"e":206.66,"text":"LET IT SHINE, SHINE, SHINE!"},{"s":206.66,"e":208.66,"text":"LET IT RISE, RISE, RISE!"},{"s":208.66,"e":211.25,"text":"May the love we give each other"},{"s":211.25,"e":213.76,"text":"Be the dawn in someone's eyes!"},{"s":213.76,"e":215.27,"text":"NO SOUL TOO SMALL!"},{"s":215.27,"e":216.86,"text":"NO ONE LEFT BEHIND!"},{"s":216.86,"e":218.53,"text":"ONE LOVE! ONE WORLD!"},{"s":218.53,"e":220.95,"text":"LET EVERY LITTLE LIGHT SHINE!"},{"s":220.95,"e":223.96,"text":"For the heart that lost a loved one,"},{"s":223.96,"e":227.05,"text":"May their memory shine through tears."},{"s":227.05,"e":229.81,"text":"For the child who fears tomorrow,"},{"s":229.81,"e":232.4,"text":"May love quiet all their fears."},{"s":232.4,"e":235.08,"text":"For the ones who cannot hear us,"},{"s":235.08,"e":237.58,"text":"For the ones who cannot speak,"},{"s":237.58,"e":240.09,"text":"For the people nobody notices,"},{"s":240.09,"e":242.43,"text":"For the humble and the meek."},{"s":242.43,"e":245.11,"text":"May the sick receive compassion,"},{"s":245.11,"e":247.53,"text":"May the grieving find relief,"},{"s":247.53,"e":250.12,"text":"May the lonely find connection,"},{"s":250.12,"e":252.55,"text":"May the doubtful find belief."},{"s":252.55,"e":255.14,"text":"And if all I have's a candle..."},{"s":255.14,"e":257.9,"text":"Then a candle's what I'll give..."},{"s":257.9,"e":260.99,"text":"Because the greatest kind of blessing"},{"s":260.99,"e":263.66,"text":"Is helping someone else to live."},{"s":263.66,"e":265.59,"text":"MORE LOVE! (MORE LOVE!)"},{"s":265.59,"e":267.68,"text":"MORE LIGHT! (MORE LIGHT!)"},{"s":267.68,"e":270.35,"text":"MORE MERCY IN THE WORLD TONIGHT!"},{"s":270.35,"e":272.27,"text":"MORE HOPE! (MORE HOPE!)"},{"s":272.27,"e":274.36,"text":"MORE PEACE! (MORE PEACE!)"},{"s":274.36,"e":276.95,"text":"MAY THE LOVE WE SHARE INCREASE!"},{"s":276.95,"e":279.13,"text":"THIS LITTLE LIGHT OF MINE!"},{"s":279.13,"e":281.05,"text":"I'M GONNA LET IT SHINE!"},{"s":281.05,"e":283.64,"text":"FROM THE DEEPEST DARKEST VALLEY"},{"s":283.64,"e":286.07,"text":"TO THE HIGHEST MOUNTAIN SIDE!"},{"s":286.07,"e":288.32,"text":"LET IT SHINE! LET IT SHINE!"},{"s":288.32,"e":290.16,"text":"LET EVERY HEART ALIGN!"},{"s":290.16,"e":293,"text":"MAY THE BLESSINGS KEEP ON BLOOMING"},{"s":293,"e":296.01,"text":"THROUGH ALL PEOPLE, SPACE, AND TIME!"},{"s":296.01,"e":298.02,"text":"Blessings on the babies!"},{"s":298.02,"e":299.94,"text":"Blessings on the brave!"},{"s":299.94,"e":301.95,"text":"Blessings on the living!"},{"s":301.95,"e":303.79,"text":"Love beyond the grave!"},{"s":303.79,"e":305.88,"text":"Blessings for the future!"},{"s":305.88,"e":307.46,"text":"Mercy for the past!"},{"s":307.46,"e":309.64,"text":"LET THE LOVE WE GIVE TODAY"},{"s":309.64,"e":312.14,"text":"BE THE LOVE THAT ALWAYS LASTS!"},{"s":312.14,"e":313.9,"text":"LET IT SHIIIIIIIIINE!"}],"duration":314.4,"source":"estimated","generatedAt":null}