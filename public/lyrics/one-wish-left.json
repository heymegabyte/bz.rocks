4,"e":222.54,"line":41},{"w":"days","s":222.54,"e":223.13,"line":41},{"w":"making","s":223.13,"e":224.03,"line":41},{"w":"wishes","s":224.03,"e":224.92,"line":41},{"w":"with","s":224.92,"e":225.52,"line":41},{"w":"you.","s":225.52,"e":226.11,"line":41},{"w":"-","s":226.11,"e":226.4,"line":42},{"w":"Look","s":226.4,"e":226.98,"line":42},{"w":"up—the","s":226.98,"e":227.85,"line":42},{"w":"last","s":227.85,"e":228.43,"line":42},{"w":"little","s":228.43,"e":229.3,"line":42},{"w":"light","s":229.3,"e":230.02,"line":42},{"w":"is","s":230.02,"e":230.31,"line":42},{"w":"gone.","s":230.31,"e":231.04,"line":42},{"w":"-","s":231.04,"e":231.33,"line":43},{"w":"Then","s":231.33,"e":231.91,"line":43},{"w":"stay","s":231.91,"e":232.49,"line":43},{"w":"right","s":232.49,"e":233.22,"line":43},{"w":"here","s":233.22,"e":233.8,"line":43},{"w":"till","s":233.8,"e":234.38,"line":43},{"w":"the","s":234.38,"e":234.81,"line":43},{"w":"morning","s":234.81,"e":235.83,"line":43},{"w":"comes.","s":235.83,"e":236.7,"line":43}],"lines":[{"s":1.2,"e":5.75,"text":"A silver streak split the summer sky."},{"s":5.75,"e":10.31,"text":"I shut my eyes, but you asked me why."},{"s":10.31,"e":15.48,"text":"I used to wish for a love that would stay,"},{"s":15.48,"e":21.27,"text":"A hand in the dark when the stars slipped away."},{"s":21.27,"e":26.07,"text":"I made little maps of the moonlit blue,"},{"s":26.07,"e":31.11,"text":"Then missed every meteor looking for you."},{"s":31.11,"e":35.92,"text":"I chased bright signs down a boulevard,"},{"s":35.92,"e":41.95,"text":"Kept my heart held close, kept my hopes on guard."},{"s":41.95,"e":48.35,"text":"Then you laughed at the rain in your midnight shoes,"},{"s":48.35,"e":53.64,"text":"And the whole wide world felt warm and new."},{"s":53.64,"e":59.55,"text":"- There’s a shooting star—go on, make your plea."},{"s":59.55,"e":65.71,"text":"- I’ve got one wish left, but you’re here with me."},{"s":65.71,"e":70.63,"text":"- What if it fades before it comes true?"},{"s":70.63,"e":75.43,"text":"- Then let it fly. I already found you."},{"s":75.43,"e":80.11,"text":"I saved my wish for a night like this,"},{"s":80.11,"e":85.16,"text":"For a slow sweet dance and a stolen kiss."},{"s":85.16,"e":89.84,"text":"One bright spark crossed a velvet sky—"},{"s":89.84,"e":93.9,"text":"I didn’t close my eyes this time."},{"s":93.9,"e":99.93,"text":"Let the stars streak past, let the night move on;"},{"s":99.93,"e":105.84,"text":"We’ve got the porch light and our favorite song."},{"s":105.84,"e":110.76,"text":"I had one wish left, and then I met you—"},{"s":110.76,"e":115.93,"text":"Now all I want is to make yours come true."},{"s":115.93,"e":122.09,"text":"When your mind makes storms out of small mistakes,"},{"s":122.09,"e":127.51,"text":"I’ll sit beside you till the morning breaks."},{"s":127.51,"e":132.92,"text":"We can sort what happened from what we fear,"},{"s":132.92,"e":137.72,"text":"Take one deep breath. I’m staying here."},{"s":137.72,"e":143.88,"text":"When your brave face breaks and the day runs long,"},{"s":143.88,"e":149.79,"text":"You can lean on me; you don’t have to be strong."},{"s":149.79,"e":155.7,"text":"We’ll make small plans when the road feels wide,"},{"s":155.7,"e":160.99,"text":"One step, two hearts, walking side by side."},{"s":160.99,"e":166.65,"text":"- There’s another star—quick, close your eyes."},{"s":166.65,"e":171.21,"text":"- I’d rather watch that wonder shine."},{"s":171.21,"e":176.5,"text":"- You sure you don’t want to wish for more?"},{"s":176.5,"e":182.66,"text":"- We can want more, love. Come dance on the porch."},{"s":182.66,"e":187.83,"text":"We saved our wishes for a night like this,"},{"s":187.83,"e":192.87,"text":"For a slow sweet dance and a stolen kiss."},{"s":192.87,"e":197.68,"text":"Bright stars race through a velvet sky—"},{"s":197.68,"e":202.48,"text":"We keep our hands held tight this time."},{"s":202.48,"e":208.51,"text":"Let the stars streak past, let the night move on;"},{"s":208.51,"e":214.42,"text":"We’ve got the porch light and our favorite song."},{"s":214.42,"e":220.45,"text":"We had one wish left, and then love came through—"},{"s":220.45,"e":226.11,"text":"Now I’ll spend my days making wishes with you."},{"s":226.11,"e":231.04,"text":"- Look up—the last little light is gone."},{"s":231.04,"e":236.7,"text":"- Then stay right here till the morning comes."}],"duration":237.2,"source":"estimated","generatedAt":null}