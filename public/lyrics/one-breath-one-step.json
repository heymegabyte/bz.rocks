s":157.08,"e":157.58,"line":43},{"w":"tonight,","s":157.58,"e":158.37,"line":43},{"w":"Stars","s":158.37,"e":158.87,"line":44},{"w":"overhead","s":158.87,"e":159.67,"line":44},{"w":"and","s":159.67,"e":159.97,"line":44},{"w":"my","s":159.97,"e":160.17,"line":44},{"w":"heart","s":160.17,"e":160.67,"line":44},{"w":"alight.","s":160.67,"e":161.37,"line":44},{"w":"If","s":161.37,"e":161.58,"line":45},{"w":"I","s":161.58,"e":161.79,"line":45},{"w":"lose","s":161.79,"e":162.2,"line":45},{"w":"my","s":162.2,"e":162.41,"line":45},{"w":"way,","s":162.41,"e":162.82,"line":45},{"w":"I","s":162.82,"e":163.03,"line":45},{"w":"can","s":163.03,"e":163.34,"line":45},{"w":"start","s":163.34,"e":163.85,"line":45},{"w":"anew—","s":163.85,"e":164.37,"line":45},{"w":"Breathe,","s":164.37,"e":165.18,"line":46},{"w":"look","s":165.18,"e":165.58,"line":46},{"w":"around;","s":165.58,"e":166.29,"line":46},{"w":"I","s":166.29,"e":166.49,"line":46},{"w":"know","s":166.49,"e":166.89,"line":46},{"w":"what","s":166.89,"e":167.29,"line":46},{"w":"to","s":167.29,"e":167.49,"line":46},{"w":"do.","s":167.49,"e":167.8,"line":46},{"w":"One","s":167.8,"e":168.11,"line":47},{"w":"breath,","s":168.11,"e":168.84,"line":47},{"w":"one","s":168.84,"e":169.15,"line":47},{"w":"step,","s":169.15,"e":169.67,"line":47},{"w":"one","s":169.67,"e":169.98,"line":47},{"w":"bright","s":169.98,"e":170.61,"line":47},{"w":"thing","s":170.61,"e":171.13,"line":47},{"w":"to","s":171.13,"e":171.34,"line":47},{"w":"do.","s":171.34,"e":171.65,"line":47},{"w":"The","s":171.65,"e":171.95,"line":48},{"w":"stars","s":171.95,"e":172.46,"line":48},{"w":"are","s":172.46,"e":172.76,"line":48},{"w":"still","s":172.76,"e":173.27,"line":48},{"w":"there.","s":173.27,"e":173.88,"line":48},{"w":"And","s":173.88,"e":174.19,"line":49},{"w":"I’m","s":174.19,"e":174.49,"line":49},{"w":"ready","s":174.49,"e":175.01,"line":49},{"w":"too.","s":175.01,"e":175.42,"line":49}],"lines":[{"s":1.2,"e":4.37,"text":"Keys by the door. Phone at a hundred."},{"s":4.37,"e":8.31,"text":"Sky full of stars, and my heart still humming."},{"s":8.31,"e":11.48,"text":"One deep breath. Let the daylight in."},{"s":11.48,"e":14.73,"text":"Love is my reason; I’m ready to begin."},{"s":14.73,"e":17.73,"text":"Water in my bag, got a backup plan,"},{"s":17.73,"e":22.61,"text":"Check the route, check the time, put the day in my hands."},{"s":22.61,"e":26.21,"text":"If the road runs red, I can reroute right;"},{"s":26.21,"e":30.75,"text":"If the forecast flips, I’ve got a coat for the night."},{"s":30.75,"e":33.83,"text":"No need to know every twist or turn—"},{"s":33.83,"e":37.77,"text":"I can ask, I can listen, I can live and learn."},{"s":37.77,"e":41.63,"text":"When a thought says “panic,” I pause and see:"},{"s":41.63,"e":45.48,"text":"Is that a fact, or a fear talking back to me?"},{"s":45.48,"e":48.48,"text":"Slow my shoulders, steady my sight,"},{"s":48.48,"e":52.25,"text":"Name what matters, make the next move right."},{"s":52.25,"e":56.53,"text":"The stars don’t vanish when the sun comes through—"},{"s":56.53,"e":60.04,"text":"They’re still up there, and I’m here too."},{"s":60.04,"e":63.56,"text":"Breathe, look around, feet on the ground,"},{"s":63.56,"e":67.15,"text":"Love in my chest when the world gets loud."},{"s":67.15,"e":70.49,"text":"Check what I know, choose what I’ll do:"},{"s":70.49,"e":74.01,"text":"One small step, then another one through."},{"s":74.01,"e":77.09,"text":"Ready in the morning, ready tonight,"},{"s":77.09,"e":80.09,"text":"Stars overhead and my heart alight."},{"s":80.09,"e":83.09,"text":"If I lose my way, I can start anew—"},{"s":83.09,"e":86.51,"text":"Breathe, look around; I know what to do."},{"s":86.51,"e":88.65,"text":"One breath! (One breath!)"},{"s":88.65,"e":90.45,"text":"One step! (One step!)"},{"s":90.45,"e":94.13,"text":"Love lights the way to whatever comes next."},{"s":94.13,"e":97.05,"text":"Call my people when I need a hand;"},{"s":97.05,"e":101.07,"text":"Strong means speaking up, not acting like I can"},{"s":101.07,"e":104.33,"text":"Carry every worry, every weight alone."},{"s":104.33,"e":107.84,"text":"I can say where I am; I can make it home."},{"s":107.84,"e":111.18,"text":"Save what I need, keep my numbers near,"},{"s":111.18,"e":115.46,"text":"Learn the lay of the land, make the choices clear."},{"s":115.46,"e":119.66,"text":"And if today goes sideways, I won’t call it done—"},{"s":119.66,"e":124.37,"text":"I’ll take the next right step, then the next right one."},{"s":124.37,"e":128.4,"text":"What if plans change? — Then we make new plans."},{"s":128.4,"e":132.76,"text":"What if I’m scared? — Let me feel it; let me stand."},{"s":132.76,"e":136.79,"text":"What if I stumble? — There’s a hand I can hold."},{"s":136.79,"e":141.33,"text":"What keeps me going? — Love when the night gets cold."},{"s":141.33,"e":144.84,"text":"Breathe, look around, feet on the ground,"},{"s":144.84,"e":148.44,"text":"Love in my chest when the world gets loud."},{"s":148.44,"e":151.78,"text":"Check what I know, choose what I’ll do:"},{"s":151.78,"e":155.29,"text":"One small step, then another one through."},{"s":155.29,"e":158.37,"text":"Ready in the morning, ready tonight,"},{"s":158.37,"e":161.37,"text":"Stars overhead and my heart alight."},{"s":161.37,"e":164.37,"text":"If I lose my way, I can start anew—"},{"s":164.37,"e":167.8,"text":"Breathe, look around; I know what to do."},{"s":167.8,"e":171.65,"text":"One breath, one step, one bright thing to do."},{"s":171.65,"e":173.88,"text":"The stars are still there."},{"s":173.88,"e":175.42,"text":"And I’m ready too."}],"duration":175.92,"source":"estimated","generatedAt":null}