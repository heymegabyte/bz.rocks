":150},{"w":"choice","s":389.95,"e":390.83,"line":150},{"w":"is","s":390.83,"e":391.13,"line":150},{"w":"training.","s":391.13,"e":392.45,"line":150},{"w":"Every","s":392.45,"e":393.16,"line":151},{"w":"repetition","s":393.16,"e":394.58,"line":151},{"w":"is","s":394.58,"e":394.87,"line":151},{"w":"becoming.","s":394.87,"e":396.14,"line":151},{"w":"So","s":396.14,"e":396.42,"line":152},{"w":"tonight...","s":396.42,"e":397.8,"line":152},{"w":"choose","s":397.8,"e":398.66,"line":153},{"w":"one","s":398.66,"e":399.09,"line":153},{"w":"thing.","s":399.09,"e":399.96,"line":153},{"w":"Tomorrow...","s":399.96,"e":401.36,"line":154},{"w":"practice","s":401.36,"e":402.47,"line":155},{"w":"it.","s":402.47,"e":402.88,"line":155},{"w":"And","s":402.88,"e":403.34,"line":156},{"w":"when","s":403.34,"e":403.95,"line":156},{"w":"you","s":403.95,"e":404.41,"line":156},{"w":"fall—","s":404.41,"e":405.17,"line":156},{"w":"begin","s":405.17,"e":405.87,"line":157},{"w":"again.","s":405.87,"e":406.7,"line":157}],"lines":[{"s":1.2,"e":2.34,"text":"Be still."},{"s":2.34,"e":6.67,"text":"Before the thought becomes a word,"},{"s":6.67,"e":11.38,"text":"before the feeling becomes an action,"},{"s":11.38,"e":13.54,"text":"there is a space."},{"s":13.54,"e":15.57,"text":"Enter the space."},{"s":15.57,"e":16.59,"text":"Breathe."},{"s":16.59,"e":21.42,"text":"You do not have to control everything."},{"s":21.42,"e":26.51,"text":"You only have to choose what comes next."},{"s":26.51,"e":28.93,"text":"When the mind says,"},{"s":28.93,"e":31.98,"text":"“They don't respect me,”"},{"s":31.98,"e":33,"text":"I ask,"},{"s":33,"e":36.31,"text":"“What do I actually know?”"},{"s":36.31,"e":38.72,"text":"When the mind says,"},{"s":38.72,"e":40.76,"text":"“I always fail,”"},{"s":40.76,"e":41.78,"text":"I ask,"},{"s":41.78,"e":43.81,"text":"“Is that a fact,"},{"s":43.81,"e":48.26,"text":"or an old story I learned to tell?”"},{"s":48.26,"e":51.82,"text":"When fear predicts tomorrow,"},{"s":51.82,"e":54.11,"text":"I return to today."},{"s":54.11,"e":55.77,"text":"What is true?"},{"s":55.77,"e":57.8,"text":"What is assumed?"},{"s":57.8,"e":61.11,"text":"What is within my control?"},{"s":61.11,"e":64.42,"text":"I can question my thinking"},{"s":64.42,"e":67.6,"text":"without attacking myself."},{"s":67.6,"e":69.38,"text":"I can be wrong"},{"s":69.38,"e":72.43,"text":"without being worthless."},{"s":72.43,"e":73.96,"text":"I can learn."},{"s":73.96,"e":75.61,"text":"I can change."},{"s":75.61,"e":78.54,"text":"I pause before I react."},{"s":78.54,"e":81.71,"text":"I breathe before I speak."},{"s":81.71,"e":84.13,"text":"I feel what I feel,"},{"s":84.13,"e":87.06,"text":"but I choose what I do."},{"s":87.06,"e":91.25,"text":"I don't need to win every moment."},{"s":91.25,"e":95.2,"text":"I don't need to prove my worth."},{"s":95.2,"e":97.61,"text":"I choose the action"},{"s":97.61,"e":100.29,"text":"that brings me closer"},{"s":100.29,"e":104.23,"text":"to the person I want to become."},{"s":104.23,"e":105.5,"text":"Calm mind."},{"s":105.5,"e":106.9,"text":"Open heart."},{"s":106.9,"e":108.55,"text":"Steady hands."},{"s":108.55,"e":110.46,"text":"One wise choice"},{"s":110.46,"e":111.73,"text":"at a time."},{"s":111.73,"e":113.9,"text":"When anger rises—"},{"s":113.9,"e":114.91,"text":"STOP."},{"s":114.91,"e":115.93,"text":"Stop."},{"s":115.93,"e":117.2,"text":"Step back."},{"s":117.2,"e":119.36,"text":"Observe the body."},{"s":119.36,"e":121.91,"text":"Observe the thought."},{"s":121.91,"e":124.07,"text":"Observe the urge."},{"s":124.07,"e":127,"text":"Do not become the urge."},{"s":127,"e":130.18,"text":"Breathe through the heat."},{"s":130.18,"e":131.32,"text":"Then ask:"},{"s":131.32,"e":137.55,"text":"“What would I respect myself for doing tomorrow?”"},{"s":137.55,"e":139.33,"text":"Maybe I speak."},{"s":139.33,"e":141.24,"text":"Maybe I listen."},{"s":141.24,"e":143.02,"text":"Maybe I leave."},{"s":143.02,"e":145.95,"text":"Maybe I set a boundary."},{"s":145.95,"e":148.24,"text":"Maybe I apologize."},{"s":148.24,"e":152.18,"text":"Strength is not getting my way."},{"s":152.18,"e":155.62,"text":"Strength is staying aligned"},{"s":155.62,"e":159.3,"text":"when emotion demands control."},{"s":159.3,"e":162.23,"text":"I pause before I react."},{"s":162.23,"e":165.41,"text":"I breathe before I speak."},{"s":165.41,"e":167.83,"text":"I feel what I feel,"},{"s":167.83,"e":170.75,"text":"but I choose what I do."},{"s":170.75,"e":173.93,"text":"I can tolerate discomfort"},{"s":173.93,"e":177.37,"text":"without creating more pain."},{"s":177.37,"e":178.89,"text":"I can say no"},{"s":178.89,"e":180.8,"text":"without hatred."},{"s":180.8,"e":182.45,"text":"I can say yes"},{"s":182.45,"e":185.76,"text":"without abandoning myself."},{"s":185.76,"e":188.05,"text":"I protect my peace"},{"s":188.05,"e":190.98,"text":"without stealing yours."},{"s":190.98,"e":192.5,"text":"Wise Mind..."},{"s":192.5,"e":194.79,"text":"Not emotion alone."},{"s":194.79,"e":196.95,"text":"Not reason alone."},{"s":196.95,"e":198.86,"text":"Feel the heart."},{"s":198.86,"e":200.64,"text":"Hear the mind."},{"s":200.64,"e":203.19,"text":"Remember the values."},{"s":203.19,"e":204.71,"text":"Then choose."},{"s":204.71,"e":206.37,"text":"What matters?"},{"s":206.37,"e":207.38,"text":"Love."},{"s":207.38,"e":208.4,"text":"Truth."},{"s":208.4,"e":209.42,"text":"Courage."},{"s":209.42,"e":210.82,"text":"Discipline."},{"s":210.82,"e":212.22,"text":"Compassion."},{"s":212.22,"e":213.24,"text":"Freedom."},{"s":213.24,"e":214.51,"text":"Integrity."},{"s":214.51,"e":218.2,"text":"Let those become the compass."},{"s":218.2,"e":220.23,"text":"I cannot control"},{"s":220.23,"e":223.28,"text":"what people think of me."},{"s":223.28,"e":225.32,"text":"I cannot control"},{"s":225.32,"e":226.46,"text":"the past."},{"s":226.46,"e":228.75,"text":"I cannot guarantee"},{"s":228.75,"e":231.42,"text":"what tomorrow brings."},{"s":231.42,"e":233.59,"text":"But I can control"},{"s":233.59,"e":236.77,"text":"whether I tell the truth."},{"s":236.77,"e":240.2,"text":"Whether I keep my promises."},{"s":240.2,"e":243.64,"text":"Whether I care for my body."},{"s":243.64,"e":247.58,"text":"Whether I protect my attention."},{"s":247.58,"e":251.39,"text":"Whether I finish what matters."},{"s":251.39,"e":255.34,"text":"Whether I repair what I damage."},{"s":255.34,"e":258.14,"text":"Whether I begin again."},{"s":258.14,"e":260.42,"text":"And that is enough"},{"s":260.42,"e":262.46,"text":"for this moment."},{"s":262.46,"e":266.02,"text":"I am allowed to grow slowly."},{"s":266.02,"e":269.33,"text":"I can do difficult things."},{"s":269.33,"e":274.03,"text":"I can survive uncomfortable feelings."},{"s":274.03,"e":278.87,"text":"I don't have to believe every thought."},{"s":278.87,"e":283.32,"text":"I don't have to obey every impulse."},{"s":283.32,"e":285.86,"text":"I can forgive myself"},{"s":285.86,"e":289.55,"text":"without excusing my behavior."},{"s":289.55,"e":292.86,"text":"I can learn from yesterday"},{"s":292.86,"e":295.53,"text":"without living there."},{"s":295.53,"e":299.22,"text":"I can appreciate what is good"},{"s":299.22,"e":304.43,"text":"without pretending everything is perfect."},{"s":304.43,"e":306.85,"text":"I can ask for help."},{"s":306.85,"e":309.52,"text":"I can change my mind."},{"s":309.52,"e":312.45,"text":"I can change my habits."},{"s":312.45,"e":314.99,"text":"I can become someone"},{"s":314.99,"e":316.26,"text":"I respect."},{"s":316.26,"e":317.28,"text":"I pause."},{"s":317.28,"e":318.55,"text":"I observe."},{"s":318.55,"e":319.7,"text":"I accept."},{"s":319.7,"e":320.84,"text":"I choose."},{"s":320.84,"e":321.86,"text":"Again."},{"s":321.86,"e":322.88,"text":"I pause."},{"s":322.88,"e":324.15,"text":"I observe."},{"s":324.15,"e":325.29,"text":"I accept."},{"s":325.29,"e":326.44,"text":"I choose."},{"s":326.44,"e":330.38,"text":"The world may remain uncertain."},{"s":330.38,"e":333.94,"text":"People may misunderstand me."},{"s":333.94,"e":336.36,"text":"Plans may collapse."},{"s":336.36,"e":338.4,"text":"Fear may return."},{"s":338.4,"e":341.19,"text":"But I will return too."},{"s":341.19,"e":343.36,"text":"Return to breath."},{"s":343.36,"e":345.39,"text":"Return to truth."},{"s":345.39,"e":347.55,"text":"Return to values."},{"s":347.55,"e":351.62,"text":"Return to the next right action."},{"s":351.62,"e":354.17,"text":"Do not seek control."},{"s":354.17,"e":355.82,"text":"Seek clarity."},{"s":355.82,"e":358.75,"text":"Do not seek perfection."},{"s":358.75,"e":360.53,"text":"Seek practice."},{"s":360.53,"e":364.47,"text":"Do not wait to become fearless."},{"s":364.47,"e":369.43,"text":"Act with courage while fear is present."},{"s":369.43,"e":372.99,"text":"The mind is not your master."},{"s":372.99,"e":377.32,"text":"Your impulses are not your master."},{"s":377.32,"e":381.01,"text":"Your past is not your master."},{"s":381.01,"e":384.82,"text":"You are the one who can pause."},{"s":384.82,"e":388.77,"text":"You are the one who can choose."},{"s":388.77,"e":392.45,"text":"And every choice is training."},{"s":392.45,"e":396.14,"text":"Every repetition is becoming."},{"s":396.14,"e":397.8,"text":"So tonight..."},{"s":397.8,"e":399.96,"text":"choose one thing."},{"s":399.96,"e":401.36,"text":"Tomorrow..."},{"s":401.36,"e":402.88,"text":"practice it."},{"s":402.88,"e":405.17,"text":"And when you fall—"},{"s":405.17,"e":406.7,"text":"begin again."}],"duration":407.2,"source":"estimated","generatedAt":null}