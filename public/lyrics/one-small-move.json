:210.71,"e":211.28,"line":51},{"w":"roots","s":211.28,"e":211.85,"line":51},{"w":"in","s":211.85,"e":212.08,"line":51},{"w":"the","s":212.08,"e":212.42,"line":51},{"w":"things","s":212.42,"e":213.11,"line":51},{"w":"I","s":213.11,"e":213.34,"line":51},{"w":"do","s":213.34,"e":213.57,"line":51},{"w":"One","s":213.57,"e":213.91,"line":52},{"w":"small","s":213.91,"e":214.47,"line":52},{"w":"move,","s":214.47,"e":215.03,"line":52},{"w":"then","s":215.03,"e":215.48,"line":52},{"w":"another","s":215.48,"e":216.27,"line":52},{"w":"one","s":216.27,"e":216.61,"line":52},{"w":"Look","s":216.61,"e":217.06,"line":53},{"w":"how","s":217.06,"e":217.41,"line":53},{"w":"far","s":217.41,"e":217.75,"line":53},{"w":"a","s":217.75,"e":217.98,"line":53},{"w":"little","s":217.98,"e":218.67,"line":53},{"w":"light","s":218.67,"e":219.24,"line":53},{"w":"can","s":219.24,"e":219.58,"line":53},{"w":"run","s":219.58,"e":219.93,"line":53},{"w":"The","s":219.93,"e":220.28,"line":54},{"w":"stars","s":220.28,"e":220.86,"line":54},{"w":"don’t","s":220.86,"e":221.44,"line":54},{"w":"rise","s":221.44,"e":221.91,"line":54},{"w":"all","s":221.91,"e":222.26,"line":54},{"w":"at","s":222.26,"e":222.5,"line":54},{"w":"once","s":222.5,"e":222.96,"line":54},{"w":"Tonight,","s":222.96,"e":223.85,"line":55},{"w":"I’ll","s":223.85,"e":224.29,"line":55},{"w":"shine","s":224.29,"e":224.85,"line":55},{"w":"with","s":224.85,"e":225.29,"line":55},{"w":"one","s":225.29,"e":225.62,"line":55}],"lines":[{"s":1.2,"e":4.24,"text":"The stars don’t rise all at once"},{"s":4.24,"e":7.94,"text":"They shine through the dark, one by one"},{"s":7.94,"e":13.16,"text":"I’ve been standing at the foot of a mountain in my mind"},{"s":13.16,"e":16.67,"text":"Counting every mile before I even try"},{"s":16.67,"e":21.41,"text":"Making little moments into mountains I can’t climb"},{"s":21.41,"e":26.82,"text":"While the clock keeps calling and I’m running out of time"},{"s":26.82,"e":32.32,"text":"So I open up the curtains, let the morning touch the floor"},{"s":32.32,"e":37.26,"text":"Put the cup into the sink, put my hand upon the door"},{"s":37.26,"e":42.95,"text":"I don’t need a grand beginning, I don’t need to know the end"},{"s":42.95,"e":48.17,"text":"I just need to make one move, then make that move again"},{"s":48.17,"e":51.4,"text":"A single spark can split the shade"},{"s":51.4,"e":54.34,"text":"A single step can start the way"},{"s":54.34,"e":57.38,"text":"One small move, then another one"},{"s":57.38,"e":61.84,"text":"I don’t need the whole sky just to face the sun"},{"s":61.84,"e":65.92,"text":"One deep breath, let the light come through"},{"s":65.92,"e":70.38,"text":"I can build a brighter life with one small move"},{"s":70.38,"e":73.6,"text":"If I fall behind, I can begin anew"},{"s":73.6,"e":76.92,"text":"Love grows roots in the things I do"},{"s":76.92,"e":79.96,"text":"One small move, then another one"},{"s":79.96,"e":83.28,"text":"Look how far a little light can run"},{"s":83.28,"e":89.35,"text":"Yeah, I used to see the staircase, swear I had to clear a flight"},{"s":89.35,"e":95.33,"text":"Then I’d sit there staring, scared to start, and lose the night"},{"s":95.33,"e":100.08,"text":"Had a list a mile long, let it live inside my head"},{"s":100.08,"e":105.3,"text":"Now I write the first line down and do that one instead"},{"s":105.3,"e":111.27,"text":"Call the friend, send the form, clean the corner, take the walk"},{"s":111.27,"e":116.97,"text":"Give the worry less of me and give my people more of my talk"},{"s":116.97,"e":122.19,"text":"I can’t promise perfect days; I can promise I’ll return"},{"s":122.19,"e":127.12,"text":"Every little follow-through is a little trust I earn"},{"s":127.12,"e":131.11,"text":"Female: A single spark can split the shade"},{"s":131.11,"e":134.24,"text":"Male: Even on the days I’m afraid"},{"s":134.24,"e":137.94,"text":"Female: A single step can start the way"},{"s":137.94,"e":140.88,"text":"Male: So I take that step today"},{"s":140.88,"e":143.92,"text":"One small move, then another one"},{"s":143.92,"e":148.38,"text":"I don’t need the whole sky just to face the sun"},{"s":148.38,"e":152.46,"text":"One deep breath, let the light come through"},{"s":152.46,"e":156.92,"text":"I can build a brighter life with one small move"},{"s":156.92,"e":160.14,"text":"If I fall behind, I can begin anew"},{"s":160.14,"e":163.47,"text":"Love grows roots in the things I do"},{"s":163.47,"e":166.5,"text":"One small move, then another one"},{"s":166.5,"e":169.82,"text":"Look how far a little light can run"},{"s":169.82,"e":173.05,"text":"Female: When I’m tired, I can rest"},{"s":173.05,"e":176.47,"text":"Male: Then return to what comes next"},{"s":176.47,"e":179.88,"text":"Female: When I’m lost, I can look up"},{"s":179.88,"e":183.2,"text":"Male: One star’s enough to guide us"},{"s":183.2,"e":187.76,"text":"Female: I don’t have to change the world tonight"},{"s":187.76,"e":190.98,"text":"Both: I can make one corner bright"},{"s":190.98,"e":194.02,"text":"One small move, then another one"},{"s":194.02,"e":198.48,"text":"I don’t need the whole sky just to face the sun"},{"s":198.48,"e":202.56,"text":"One deep breath, let the light come through"},{"s":202.56,"e":207.02,"text":"I can build a brighter life with one small move"},{"s":207.02,"e":210.25,"text":"If I fall behind, I can begin anew"},{"s":210.25,"e":213.57,"text":"Love grows roots in the things I do"},{"s":213.57,"e":216.61,"text":"One small move, then another one"},{"s":216.61,"e":219.93,"text":"Look how far a little light can run"},{"s":219.93,"e":222.96,"text":"The stars don’t rise all at once"},{"s":222.96,"e":225.62,"text":"Tonight, I’ll shine with one"}],"duration":226.12,"source":"estimated","generatedAt":null}