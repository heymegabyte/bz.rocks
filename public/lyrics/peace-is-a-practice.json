7},{"w":"good,","s":317.06,"e":317.6,"line":77},{"w":"grounded","s":317.6,"e":318.46,"line":77},{"w":"line.","s":318.46,"e":319,"line":77},{"w":"The","s":319,"e":319.33,"line":78},{"w":"song","s":319.33,"e":319.78,"line":78},{"w":"slips","s":319.78,"e":320.34,"line":78},{"w":"to","s":320.34,"e":320.56,"line":78},{"w":"silence;","s":320.56,"e":321.46,"line":78},{"w":"I","s":321.46,"e":321.68,"line":78},{"w":"stand","s":321.68,"e":322.24,"line":78},{"w":"in","s":322.24,"e":322.46,"line":78},{"w":"the","s":322.46,"e":322.8,"line":78},{"w":"day,","s":322.8,"e":323.24,"line":78},{"w":"With","s":323.24,"e":323.69,"line":79},{"w":"peace","s":323.69,"e":324.26,"line":79},{"w":"in","s":324.26,"e":324.48,"line":79},{"w":"my","s":324.48,"e":324.71,"line":79},{"w":"practice,","s":324.71,"e":325.72,"line":79},{"w":"I","s":325.72,"e":325.95,"line":79},{"w":"walk","s":325.95,"e":326.4,"line":79},{"w":"on","s":326.4,"e":326.62,"line":79},{"w":"my","s":326.62,"e":326.85,"line":79},{"w":"way.","s":326.85,"e":327.3,"line":79}],"lines":[{"s":1.2,"e":4.98,"text":"Soft shoulders settle; I soften my stare,"},{"s":4.98,"e":8.95,"text":"Slow, steady breathing; no forcing the air."},{"s":8.95,"e":13.1,"text":"Feet find the floor; I can feel what is real,"},{"s":13.1,"e":16.51,"text":"Patiently present, I let myself feel."},{"s":16.51,"e":20.47,"text":"Morning makes mirrors of light on the wall,"},{"s":20.47,"e":24.35,"text":"My mind makes a movie; I don't buy it all."},{"s":24.35,"e":28.04,"text":"Fear paints the future in permanent ink,"},{"s":28.04,"e":32.56,"text":"I fact-check the forecast; I pause, then I think."},{"s":32.56,"e":37.26,"text":"Thoughts thunder through me; I give them some room,"},{"s":37.26,"e":40.67,"text":"Patient as petals preparing to bloom."},{"s":40.67,"e":45.01,"text":"I listen with love, let the loud feeling speak,"},{"s":45.01,"e":49.34,"text":"Kindness keeps calling; it's peace that I seek."},{"s":49.34,"e":53.21,"text":"Thumb and two fingers; I touch and return,"},{"s":53.21,"e":57.09,"text":"Practice with patience, a pattern I learn."},{"s":57.09,"e":61.33,"text":"Naming, not shaming, the storm moving through,"},{"s":61.33,"e":65.02,"text":"Calm isn't conquest; I choose what I do."},{"s":65.02,"e":68.52,"text":"Peace is a practice; I practice today,"},{"s":68.52,"e":71.84,"text":"Softening slowly, I find my own way."},{"s":71.84,"e":76.08,"text":"Clear mind, kind heart; let a little light in,"},{"s":76.08,"e":80.05,"text":"Breathe, be kind, begin—let compassion win."},{"s":80.05,"e":83.92,"text":"Steady, not stone; I can bend, I can grow,"},{"s":83.92,"e":88.44,"text":"Make room for the moment; let good feelings flow."},{"s":88.44,"e":93.05,"text":"Give my gifts to goodness; keep compassion bright,"},{"s":93.05,"e":97.02,"text":"Let my love do labor; leave a little light."},{"s":97.02,"e":101.72,"text":"When pressure piles problems, I pause, then I plan,"},{"s":101.72,"e":106.15,"text":"Pick one little piece; do the first thing I can."},{"s":106.15,"e":110.58,"text":"If worry starts whirling, I pause, then I write,"},{"s":110.58,"e":115.1,"text":"One small, simple step—not my whole life tonight."},{"s":115.1,"e":119.34,"text":"Screen stays silent; one task takes the stage,"},{"s":119.34,"e":123.4,"text":"Focus finds footholds, one line on the page."},{"s":123.4,"e":127.08,"text":"Five focused minutes; a finish in sight,"},{"s":127.08,"e":130.77,"text":"Little by little, I build what is right."},{"s":130.77,"e":134.65,"text":"Dreams need a doorway, not just a display,"},{"s":134.65,"e":138.61,"text":"I picture the process, then practice today."},{"s":138.61,"e":143.13,"text":"When plans meet a problem, I pause and get clear,"},{"s":143.13,"e":147.56,"text":"Seek steady support; let a kind voice come near."},{"s":147.56,"e":152.08,"text":"Slow progress is progress; no prize for the pace,"},{"s":152.08,"e":155.77,"text":"Rest has a rhythm; I give it some space."},{"s":155.77,"e":159.27,"text":"Peace is a practice; I practice today,"},{"s":159.27,"e":162.59,"text":"Softening slowly, I find my own way."},{"s":162.59,"e":166.83,"text":"Clear mind, kind heart; let a little light in,"},{"s":166.83,"e":170.8,"text":"Breathe, be kind, begin—let compassion win."},{"s":170.8,"e":174.67,"text":"Steady, not stone; I can bend, I can grow,"},{"s":174.67,"e":179.19,"text":"Make room for the moment; let good feelings flow."},{"s":179.19,"e":183.8,"text":"Give my gifts to goodness; keep compassion bright,"},{"s":183.8,"e":187.77,"text":"Let my love do labor; leave a little light."},{"s":187.77,"e":191.73,"text":"Sun spills its sweetness; I savor the glow,"},{"s":191.73,"e":195.33,"text":"Small, simple wonders in places I know."},{"s":195.33,"e":199.76,"text":"Warm words, wide windows, the laugh of a friend,"},{"s":199.76,"e":203.72,"text":"Little lights linger when long shadows end."},{"s":203.72,"e":207.87,"text":"I give gratitude room without silencing pain,"},{"s":207.87,"e":212.21,"text":"Let laughter and longing both live in the rain."},{"s":212.21,"e":216.72,"text":"Soft sheets, slow evenings; I rest from the race,"},{"s":216.72,"e":220.6,"text":"Morning means movement; I move at my pace."},{"s":220.6,"e":225.49,"text":"When heat hits my heartbeat, I wait through the wave,"},{"s":225.49,"e":230.37,"text":"Soft speech, steady strength; I choose how to behave."},{"s":230.37,"e":234.8,"text":"Heart hears the hurt; reason reads what is true,"},{"s":234.8,"e":238.3,"text":"Values give vision for what I will do."},{"s":238.3,"e":242.27,"text":"Boundaries build balance; a no can be kind,"},{"s":242.27,"e":246.24,"text":"Care can be clear without changing my mind."},{"s":246.24,"e":250.66,"text":"Strong hands hold softly; I don't have to shove,"},{"s":250.66,"e":254.54,"text":"Real power repairs; it responds with love."},{"s":254.54,"e":258.41,"text":"Clear doesn't mean I'm completely correct,"},{"s":258.41,"e":262.1,"text":"Let listening lead me to deeper respect."},{"s":262.1,"e":266.16,"text":"No shame in a stumble; I soften, then start,"},{"s":266.16,"e":270.03,"text":"Practice puts patience back into my heart."},{"s":270.03,"e":274.09,"text":"My worth isn't work, isn't winning the race,"},{"s":274.09,"e":278.24,"text":"I'm worthy of warmth while I grow at my pace."},{"s":278.24,"e":281.74,"text":"Peace is a practice; I practice today,"},{"s":281.74,"e":285.06,"text":"Softening slowly, I find my own way."},{"s":285.06,"e":289.3,"text":"Clear mind, kind heart; let a little light in,"},{"s":289.3,"e":293.27,"text":"Breathe, be kind, begin—let compassion win."},{"s":293.27,"e":297.14,"text":"Steady, not stone; I can bend, I can grow,"},{"s":297.14,"e":301.66,"text":"Make room for the moment; let good feelings flow."},{"s":301.66,"e":306.27,"text":"Give my gifts to goodness; keep compassion bright,"},{"s":306.27,"e":310.24,"text":"Let my love do labor; leave a little light."},{"s":310.24,"e":314.57,"text":"Soft shoulders settle; the small start is mine,"},{"s":314.57,"e":319,"text":"One kind, clear choice; one good, grounded line."},{"s":319,"e":323.24,"text":"The song slips to silence; I stand in the day,"},{"s":323.24,"e":327.3,"text":"With peace in my practice, I walk on my way."}],"duration":327.8,"source":"estimated","generatedAt":null}