:145.32,"e":145.88,"line":22},{"w":"hands.","s":145.88,"e":146.73,"line":22},{"w":"Hear","s":146.73,"e":147.3,"line":23},{"w":"the","s":147.3,"e":147.73,"line":23},{"w":"sound,","s":147.73,"e":148.58,"line":23},{"w":"see","s":148.58,"e":149.01,"line":23},{"w":"the","s":149.01,"e":149.44,"line":23},{"w":"light,","s":149.44,"e":150.29,"line":23},{"w":"meet","s":150.29,"e":150.86,"line":23},{"w":"the","s":150.86,"e":151.29,"line":23},{"w":"moment","s":151.29,"e":152.15,"line":23},{"w":"as","s":152.15,"e":152.43,"line":23},{"w":"it","s":152.43,"e":152.72,"line":23},{"w":"stands.","s":152.72,"e":153.72,"line":23},{"w":"Then","s":153.72,"e":154.29,"line":24},{"w":"take","s":154.29,"e":154.86,"line":24},{"w":"one","s":154.86,"e":155.28,"line":24},{"w":"honest","s":155.28,"e":156.14,"line":24},{"w":"step","s":156.14,"e":156.71,"line":24},{"w":"with","s":156.71,"e":157.28,"line":24},{"w":"both","s":157.28,"e":157.85,"line":24},{"w":"your","s":157.85,"e":158.42,"line":24},{"w":"feet","s":158.42,"e":158.99,"line":24},{"w":"upon","s":158.99,"e":159.56,"line":24},{"w":"the","s":159.56,"e":159.99,"line":24},{"w":"land.","s":159.99,"e":160.7,"line":24},{"w":"Right","s":160.7,"e":161.36,"line":25},{"w":"here,","s":161.36,"e":162.02,"line":25},{"w":"right","s":162.02,"e":162.68,"line":25},{"w":"now—begin","s":162.68,"e":163.87,"line":25},{"w":"again.","s":163.87,"e":164.66,"line":25}],"lines":[{"s":1.2,"e":7.49,"text":"I chased a brighter morning, dragged yesterday behind,"},{"s":7.49,"e":13.54,"text":"Built a house of what-ifs in the corners of my mind."},{"s":13.54,"e":22.04,"text":"Then I heard the rain against the window, felt the floor beneath my feet—"},{"s":22.04,"e":29.96,"text":"For one breath, I could hear the world beneath my worried heartbeat."},{"s":29.96,"e":34.15,"text":"A thought said, “You’re your story.”"},{"s":34.15,"e":38.34,"text":"I watched that thought pass through."},{"s":38.34,"e":42.07,"text":"There was room around the noise,"},{"s":42.07,"e":46.14,"text":"And room to choose what I would do."},{"s":46.14,"e":52.43,"text":"Breathe in, feel your feet, let the rushing river run."},{"s":52.43,"e":59.65,"text":"Name the fear; don’t feed it. Feel the warmth upon your hands."},{"s":59.65,"e":66.63,"text":"Hear the sound, see the light, meet the moment as it stands."},{"s":66.63,"e":73.62,"text":"Then take one honest step with both your feet upon the land."},{"s":73.62,"e":77.57,"text":"Right here, right now—begin again."},{"s":77.57,"e":84.79,"text":"Enlightenment, the way he tells it, isn’t winning every fight;"},{"s":84.79,"e":91.89,"text":"It’s waking from the grip of thought and seeing what’s alive."},{"s":91.89,"e":98.76,"text":"The ache may still be aching; you can let it have its name."},{"s":98.76,"e":105.98,"text":"You can face the facts before you choose what needs to change."},{"s":105.98,"e":112.27,"text":"When the mind runs to tomorrow, notice: I am thinking."},{"s":112.27,"e":119.25,"text":"Bring attention to your breathing; feel your hands and feet."},{"s":119.25,"e":125.77,"text":"Let this moment be the moment—then answer what it needs."},{"s":125.77,"e":133.23,"text":"If you drift a hundred times, return a hundred times to breathe."},{"s":133.23,"e":139.51,"text":"Breathe in, feel your feet, let the rushing river run."},{"s":139.51,"e":146.73,"text":"Name the fear; don’t feed it. Feel the warmth upon your hands."},{"s":146.73,"e":153.72,"text":"Hear the sound, see the light, meet the moment as it stands."},{"s":153.72,"e":160.7,"text":"Then take one honest step with both your feet upon the land."},{"s":160.7,"e":164.66,"text":"Right here, right now—begin again."}],"duration":165.16,"source":"estimated","generatedAt":null}