ne":30},{"w":"wings","s":184.82,"e":185.66,"line":30},{"w":"sing…","s":185.66,"e":186.49,"line":30},{"w":"“We","s":186.49,"e":187.01,"line":31},{"w":"can","s":187.01,"e":187.54,"line":31},{"w":"soar","s":187.54,"e":188.24,"line":31},{"w":"again.”","s":188.24,"e":189.46,"line":31}],"lines":[{"s":1.2,"e":7.58,"text":"Paper planes pass through the pouring rain,"},{"s":7.58,"e":13.37,"text":"Silver wings sing, “We can soar again.”"},{"s":13.37,"e":19.02,"text":"I kept a crumpled wish beneath my bed,"},{"s":19.02,"e":25.99,"text":"A little letter filled with words I never said."},{"s":25.99,"e":33.42,"text":"The cold clock called, but I could hear that tune:"},{"s":33.42,"e":40.69,"text":"“Send your small, scared dreams across the moon.”"},{"s":40.69,"e":47.52,"text":"Back when the bus broke down on the boulevard,"},{"s":47.52,"e":53.31,"text":"I built big plans from a backyard card."},{"s":53.31,"e":58.66,"text":"Bills blew in; I bent, but I stayed,"},{"s":58.66,"e":64.75,"text":"Folded fresh wings from the mess we made."},{"s":64.75,"e":71.28,"text":"Mama said, “Move when the road looks steep.”"},{"s":71.28,"e":77.51,"text":"So I saved that spark when the city slept."},{"s":77.51,"e":84.05,"text":"- Let the wild wind wear these worries thin."},{"s":84.05,"e":88.05,"text":"- Let them in, let them in."},{"s":88.05,"e":94.59,"text":"- Hear those small wings beating once again."},{"s":94.59,"e":98.3,"text":"- Rise again, rise again."},{"s":98.3,"e":104.68,"text":"Paper planes pass through the pouring rain,"},{"s":104.68,"e":110.03,"text":"Fly, fly, fly till we’re free again."},{"s":110.03,"e":116.41,"text":"Bright little dreams break the bitter blue,"},{"s":116.41,"e":122.2,"text":"Higher, higher—heaven’s coming through."},{"s":122.2,"e":128.59,"text":"Paper planes pass through the pouring rain,"},{"s":128.59,"e":134.67,"text":"Lost little wings can learn to fly again."},{"s":134.67,"e":140.46,"text":"If one wing falls, we’ll fold one more."},{"s":140.46,"e":146.4,"text":"If rain rolls in, we’ll reach the shore."},{"s":146.4,"e":152.49,"text":"- I see my younger self beneath that sky."},{"s":152.49,"e":159.91,"text":"- I tell that kid, “Keep your wings. Keep trying.”"},{"s":159.91,"e":166.3,"text":"Paper planes pass through the pouring rain,"},{"s":166.3,"e":171.64,"text":"Fly, fly, fly till we’re free again."},{"s":171.64,"e":178.03,"text":"Bright little dreams break the bitter blue,"},{"s":178.03,"e":183.82,"text":"Higher, higher—heaven’s coming through."},{"s":183.82,"e":186.49,"text":"Silver wings sing…"},{"s":186.49,"e":189.46,"text":"“We can soar again.”"}],"duration":189.96,"source":"estimated","generatedAt":null}